---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Welcome to the official website of Rabbi Joseph Dweck." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Rabbi Joseph Dweck</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://sibforms.com/forms/end-form/build/sib-styles.css" />
    <link rel="icon" type="image/png" href="/images/rjd.png" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo-link">
          <img src="/images/Copy of ORD - Logo (A4.png" alt="Rabbi Joseph Dweck" class="logo" />
        </a>
        <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
          <span></span><span></span><span></span>
        </button>
        <nav class="main-nav" id="mainNav">
          <ul>
            <li><a href="/">HOME</a></li>
            <li><a href="/rabbi">THE RABBI</a></li>
            <li class="has-dropdown">
              <a href="/content">CONTENT</a>
              <ul class="dropdown">
                <li><a href="/writings">WRITINGS</a></li>
                <li><a href="/video">VIDEO</a></li>
                <li><a href="/audio">AUDIO</a></li>
              </ul>
            </li>
          </ul>
        </nav>
        <div class="social-links">
          <a href="https://chat.whatsapp.com/HONcznKDXy6KqXHI2Hptoj" target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
          <a href="https://www.instagram.com/rabbidweck" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://youtube.com/channel/UCqIwxvf2D0JEgg0LOXZcFsA" target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://www.x.com/rabbidweck" target="_blank" rel="noopener" aria-label="X / Twitter">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.741l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-logo">
          <img src="https://static.wixstatic.com/media/4959e2_f07c8e32776f4373a586b45bb3767d6d~mv2.png/v1/fill/w_285,h_285,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Copy%20of%20ORD%20-%20Logo%20(A4).png" alt="Rabbi Joseph Dweck" />
        </div>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/rabbi">The Rabbi</a>
          <a href="/content">Content</a>
          <a href="/parasha">The Parasha</a>
          <a href="/writings">Writings</a>
          <a href="/perspectives">Perspectives</a>
          <a href="/mentalhealth">Mental Health</a>
        </div>
        <div class="footer-social">
          <p>Connect with Rabbi Dweck</p>
          <div class="social-row">
            <a href="https://chat.whatsapp.com/HONcznKDXy6KqXHI2Hptoj" target="_blank" rel="noopener">WhatsApp</a>
            <a href="https://www.instagram.com/rabbidweck" target="_blank" rel="noopener">Instagram</a>
            <a href="https://youtube.com/channel/UCqIwxvf2D0JEgg0LOXZcFsA" target="_blank" rel="noopener">YouTube</a>
            <a href="https://www.x.com/rabbidweck" target="_blank" rel="noopener">X</a>
          </div>
        </div>
        <p class="footer-copy">&copy; {new Date().getFullYear()} Rabbi Joseph Dweck. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('navToggle');
      const nav = document.getElementById('mainNav');
      toggle?.addEventListener('click', () => {
        nav?.classList.toggle('open');
      });
      document.querySelectorAll('.has-dropdown > a').forEach(link => {
        link.addEventListener('click', (e) => {
          if (window.innerWidth < 768) {
            e.preventDefault();
            link.parentElement?.classList.toggle('active');
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --gold: #b8974a;
    --gold-light: #d4b06a;
    --dark: #1a1a1a;
    --dark-mid: #2c2c2c;
    --cream: #f8f4ee;
    --cream-dark: #ede8df;
    --text: #333333;
    --text-light: #666666;
    --white: #ffffff;
    --font-serif: 'Marcellus', Georgia, serif;
    --font-sans: 'Lato', system-ui, sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-sans);
    color: var(--text);
    background: var(--white);
    line-height: 1.7;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-serif);
    color: var(--dark);
    line-height: 1.3;
  }

  a { color: inherit; text-decoration: none; }

  img { max-width: 100%; height: auto; display: block; }

  /* ── HEADER ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--white);
    border-bottom: 1px solid var(--cream-dark);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 80px;
  }

  .logo-link { flex-shrink: 0; }
  .logo { height: 56px; width: auto; }

  .main-nav { flex: 1; }
  .main-nav ul { list-style: none; display: flex; gap: 0.25rem; align-items: center; }
  .main-nav > ul > li > a {
    font-family: var(--font-serif);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dark);
    padding: 0.5rem 0.75rem;
    border-radius: 3px;
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .main-nav > ul > li > a:hover { color: var(--gold); }

  .has-dropdown { position: relative; }
  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--white);
    border: 1px solid var(--cream-dark);
    border-top: 3px solid var(--gold);
    min-width: 220px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    z-index: 200;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.2s, visibility 0.2s, transform 0.2s;
  }
  .has-dropdown:hover .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown li a {
    display: block;
    padding: 0.65rem 1.25rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    font-family: var(--font-serif);
    border-bottom: 1px solid var(--cream);
    transition: background 0.2s, color 0.2s;
  }
  .dropdown li a:hover { background: var(--cream); color: var(--gold); }
  .dropdown li:last-child a { border-bottom: none; }

  .social-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-left: auto;
    flex-shrink: 0;
  }
  .social-links a {
    color: var(--text-light);
    transition: color 0.2s;
    display: flex;
  }
  .social-links a:hover { color: var(--gold); }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--dark);
    border-radius: 2px;
    transition: all 0.3s;
  }

  /* ── FOOTER ── */
  .site-footer {
    background: var(--dark);
    color: var(--cream);
    padding: 3rem 1.5rem 2rem;
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    text-align: center;
  }
  .footer-logo img { height: 70px; width: auto; filter: brightness(0.85); }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: center;
  }
  .footer-links a {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cream-dark);
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--gold-light); }
  .footer-social p {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-light);
    margin-bottom: 0.5rem;
    font-family: var(--font-serif);
  }
  .social-row { display: flex; gap: 1.5rem; justify-content: center; }
  .social-row a {
    font-size: 0.8rem;
    color: var(--cream-dark);
    transition: color 0.2s;
    letter-spacing: 0.05em;
  }
  .social-row a:hover { color: var(--gold-light); }
  .footer-copy {
    font-size: 0.75rem;
    color: #888;
    margin-top: 0.5rem;
  }

  /* ── UTILITIES ── */
  .page-hero {
    background: var(--cream);
    border-bottom: 3px solid var(--gold);
    padding: 4rem 1.5rem 3.5rem;
    text-align: center;
  }
  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--dark);
    margin-bottom: 0.75rem;
    letter-spacing: 0.04em;
  }
  .page-hero p {
    font-size: 1.05rem;
    color: var(--text-light);
    max-width: 640px;
    margin: 0 auto;
  }
  .page-hero .gold-rule {
    width: 60px;
    height: 2px;
    background: var(--gold);
    margin: 1.25rem auto 0;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section { padding: 4rem 1.5rem; }
  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    color: var(--dark);
    margin-bottom: 0.5rem;
    letter-spacing: 0.03em;
  }
  .gold-divider {
    width: 50px;
    height: 2px;
    background: var(--gold);
    margin-bottom: 2rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    font-family: var(--font-serif);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 2px solid var(--gold);
    color: var(--gold);
    background: transparent;
    cursor: pointer;
    transition: background 0.25s, color 0.25s;
    text-decoration: none;
  }
  .btn:hover { background: var(--gold); color: var(--white); }
  .btn-solid { background: var(--gold); color: var(--white); }
  .btn-solid:hover { background: var(--gold-light); border-color: var(--gold-light); }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }
  .card {
    background: var(--white);
    border: 1px solid var(--cream-dark);
    border-top: 3px solid var(--gold);
    transition: box-shadow 0.25s, transform 0.25s;
    overflow: hidden;
  }
  .card:hover { box-shadow: 0 8px 30px rgba(0,0,0,0.1); transform: translateY(-3px); }
  .card-img { width: 100%; height: 200px; object-fit: cover; }
  .card-body { padding: 1.5rem; }
  .card-body h3 { font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--dark); }
  .card-body p { font-size: 0.9rem; color: var(--text-light); line-height: 1.6; }
  .card-body .btn { margin-top: 1.25rem; font-size: 0.78rem; }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .photo-grid img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 2px;
    transition: opacity 0.2s;
  }
  .photo-grid img:hover { opacity: 0.9; }

  @media (max-width: 768px) {
    .header-inner { flex-wrap: wrap; height: auto; padding: 1rem 1.5rem; }
    .nav-toggle { display: flex; order: 2; margin-left: auto; }
    .social-links { order: 3; width: 100%; justify-content: center; padding-bottom: 0.5rem; display: none; }
    .main-nav {
      order: 4;
      width: 100%;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease;
    }
    .main-nav.open { max-height: 800px; }
    .main-nav ul { flex-direction: column; gap: 0; }
    .main-nav > ul > li > a { display: block; padding: 0.75rem 0; border-bottom: 1px solid var(--cream-dark); font-size: 0.9rem; }
    .dropdown { position: static; box-shadow: none; border: none; border-top: none; background: var(--cream); opacity: 1; visibility: visible; transform: none; display: none; padding-left: 1rem; }
    .has-dropdown.active .dropdown { display: flex; }
    .has-dropdown > a::after { content: ' ▾'; }
  }
</style>
