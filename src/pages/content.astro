---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Content" description="Explore Rabbi Dweck's writings, video, audio, parasha, and perspectives.">

  <section class="page-hero">
    <h1>Content</h1>
    <p>Writings, video, audio, and more from Rabbi Joseph Dweck</p>
    <div class="gold-rule"></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">

        <a href="/parasha" class="card">
          <img class="card-img" src="/images/4959e2_1396aa8b41ef425d80e0c61b8d265e39.jpg" alt="The Parasha" />
          <div class="card-body">
            <h3>The Parasha</h3>
            <p>Audio and video recordings on the weekly Torah portion from Rabbi Dweck across the entire yearly cycle.</p>
            <span class="btn" style="margin-top:1rem; font-size:0.78rem;">Explore →</span>
          </div>
        </a>

        <a href="/perspectives" class="card">
          <img class="card-img" src="/images/4959e2_b8bd16ceb7914834bc6425156df89bb0.avif" alt="Perspectives" />
          <div class="card-body">
            <h3>Perspectives</h3>
            <p>A digital series of bite-size 1–3 minute meditations on Judaism's major ideas across two seasons.</p>
            <span class="btn" style="margin-top:1rem; font-size:0.78rem;">Watch →</span>
          </div>
        </a>

        <a href="/writings" class="card">
          <img class="card-img" src="/images/4959e2_2f333107d2e447378fbea2398fa78ce8.png" alt="Writings" />
          <div class="card-body">
            <h3>Writings</h3>
            <p>Thought-provoking essays by Rabbi Dweck for individual and family reading, plus the This Is Judaism Substack.</p>
            <span class="btn" style="margin-top:1rem; font-size:0.78rem;">Read →</span>
          </div>
        </a>

        <a href="/video" class="card">
          <img class="card-img" src="/images/4959e2_c020170c08ed4ec6a22933dacd1f1f10.png" alt="Video" />
          <div class="card-body">
            <h3>Video</h3>
            <p>A growing library of recorded lectures, shiurim, and talks available on YouTube and beyond.</p>
            <span class="btn" style="margin-top:1rem; font-size:0.78rem;">Watch →</span>
          </div>
        </a>

        <a href="/audio" class="card">
          <img class="card-img" src="/images/4959e2_4b9b31d3c03d4e9c84f60c45f7c0b188.png" alt="Audio" />
          <div class="card-body">
            <h3>Audio</h3>
            <p>Listen to Rabbi Dweck's lectures and shiurim on The Parasha with Rabbi Dweck, available on Spotify and more.</p>
            <span class="btn" style="margin-top:1rem; font-size:0.78rem;">Listen →</span>
          </div>
        </a>

      </div>
    </div>
  </section>

</Layout>
