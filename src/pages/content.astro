---
import Layout from '../layouts/Layout.astro';

const items = [
  {
    href: '/video',
    title: 'Video',
    label: 'Watch',
    img: '/images/The Parasha.png',
    desc: 'A growing library of recorded lectures, shiurim, and talks — from the weekly Parasha to deep philosophical discussions.',
  },
  {
    href: '/audio',
    title: 'Audio',
    label: 'Listen',
    img: '/images/The Thought for the Day.png',
    desc: 'Listen to Rabbi Dweck's shiurim and lectures on Spotify, Apple Podcasts, and all major podcast platforms.',
  },
  {
    href: '/writings',
    title: 'Writings',
    label: 'Read',
    img: '/images/Perspectives.png',
    desc: 'Thought-provoking essays and the This Is Judaism Substack — exploring what Judaism is, what it means, and why it matters.',
  },
];
---

<Layout title="Content" description="Explore Rabbi Dweck's video, audio, and writings.">

  <section class="page-hero">
    <h1>Content</h1>
    <p>Video, audio, and writings from Rabbi Joseph Dweck</p>
    <div class="gold-rule"></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="feature-grid">
        {items.map(item => (
          <a href={item.href} class="feature-card">
            <div class="feature-img-wrap">
              <img src={item.img} alt={item.title} />
              <div class="feature-overlay">
                <span class="feature-cta">{item.label} →</span>
              </div>
            </div>
            <div class="feature-body">
              <h2>{item.title}</h2>
              <div class="feature-rule"></div>
              <p>{item.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  .section { padding: 3rem 0 5rem; }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    color: var(--dark);
    transition: transform 0.25s;
  }
  .feature-card:hover { transform: translateY(-4px); }

  .feature-img-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3/4;
  }
  .feature-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .feature-card:hover .feature-img-wrap img { transform: scale(1.04); }

  .feature-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 55%);
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .feature-card:hover .feature-overlay { opacity: 1; }
  .feature-cta {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white);
    border-bottom: 1px solid var(--gold);
    padding-bottom: 2px;
  }

  .feature-body {
    padding: 1.5rem 0.25rem 0;
  }
  .feature-body h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--dark);
    margin-bottom: 0.6rem;
  }
  .feature-rule {
    width: 36px;
    height: 2px;
    background: var(--gold);
    margin-bottom: 0.85rem;
  }
  .feature-body p {
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--text-light);
  }

  @media (max-width: 768px) {
    .feature-grid { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
    .feature-overlay { opacity: 1; }
  }
</style>
