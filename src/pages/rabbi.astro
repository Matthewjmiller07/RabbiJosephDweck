---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Rabbi" description="About Rabbi Joseph Dweck.">

  <section class="page-hero">
    <h1>The Rabbi</h1>
    <div class="gold-rule"></div>
  </section>

  <section class="section">
    <div class="container bio-layout">
      <div class="bio-image">
        <img src="/images/GK5StT7XMAA8fJB.avif" alt="Rabbi Joseph Dweck" />
      </div>
      <div class="bio-text">
        <h2 class="section-title">Rabbi Joseph Dweck</h2>
        <div class="gold-divider"></div>
        <p>
          Rabbi Joseph Dweck was born and raised in Brooklyn, New York. He formerly served as Senior Rabbi
          of the S&amp;P Sephardi Community of the United Kingdom.
        </p>
        <p>
          He teaches Torah, Halakha, and Jewish thought through the weekly Parasha, the Thought for the Day,
          the Perspectives video series, The Ḥabura, and his writings.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--cream);">
    <div class="container">
      <h2 class="section-title">Educational Work</h2>
      <div class="gold-divider"></div>
      <div class="edu-grid">
        <a href="/parasha" class="edu-item">
          <h3>The Parasha</h3>
          <p>Weekly Torah commentary</p>
        </a>
        <a href="/thoughts" class="edu-item">
          <h3>Thought for the Day</h3>
          <p>Short daily reflections</p>
        </a>
        <a href="/perspectives" class="edu-item">
          <h3>Perspectives</h3>
          <p>Bite-size video meditations</p>
        </a>
        <a href="/writings" class="edu-item">
          <h3>Writings</h3>
          <p>Essays &amp; Substack</p>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .bio-layout {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 4rem;
    align-items: start;
  }
  .bio-image img {
    width: 100%;
    border-top: 4px solid var(--gold);
    box-shadow: 10px 10px 0 var(--cream-dark);
  }
  .bio-text p { margin-bottom: 1rem; color: var(--text); line-height: 1.8; }

  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 2rem;
  }
  .edu-item {
    display: block;
    text-align: center;
    background: var(--white);
    border-top: 3px solid var(--gold);
    padding: 2rem 1.5rem;
    transition: transform 0.2s;
  }
  .edu-item:hover { transform: translateY(-4px); }
  .edu-item h3 { font-size: 1.1rem; color: var(--dark); margin-bottom: 0.25rem; }
  .edu-item p { font-size: 0.85rem; color: var(--text-light); }

  @media (max-width: 768px) {
    .bio-layout { grid-template-columns: 1fr; }
  }
</style>
