---
import Layout from '../layouts/Layout.astro';
import clips from '../data/reels.json';

const broll = {
  navy: ['jerusalem', 'Storm over Jerusalem'],
  parchment: ['candles', 'Shabbat candles, macro'],
  cinema: ['archer', 'Archer at golden hour'],
  stone: ['camels', 'Negev caravan, drone'],
  editorial: ['library', 'Old library aisles'],
};
const moods = [
  { img: 'jerusalem', title: 'Landscape & sky', note: 'Jerusalem and Judean hills, storms, first light. Slow time-lapse, 24–35mm.' },
  { img: 'library', title: 'Texture of learning', note: 'Old books, parchment, quills, dust in light. Slow dolly, shallow focus.' },
  { img: 'candles', title: 'Ritual, up close', note: 'Candles, mezuza, tallit, the Kotel. Macro, warm tungsten, no faces.' },
  { img: 'archer', title: 'Literal metaphor', note: 'Show the idea itself: the archer for chet, the camel for gemilut chasadim.' },
  { img: 'camels', title: 'Scale & journey', note: 'Desert, roads, caravans from the air. Gives a 60-second thought room to breathe.' },
];
const styles = [
  { key: 'navy', name: 'Haftara Navy', note: 'The live Haftara reel look: deep navy, ice-blue keywords, word-by-word caption boxes. Proven, bold, and high-retention.' },
  { key: 'parchment', name: 'Parchment & Gold', note: 'Matches The Parasha channel brand: cream ground, gold rules, ink captions set in Marcellus. Warm and dignified.' },
  { key: 'cinema', name: 'Cinematic Black', note: 'Letterboxed, full-bleed b-roll, white Marcellus captions with a gold active word. Reads like a film trailer.' },
  { key: 'stone', name: 'Jerusalem Stone', note: 'Warm limestone grade, Hebrew watermark, small-caps captions. Calm and meditative, made for reflective thoughts.' },
  { key: 'editorial', name: 'Editorial Split', note: 'B-roll in the top half, Rabbi Dweck below, a pull-quote band between. Magazine-style, and b-roll stays on screen throughout.' },
];

const ends = [
  { key: 'socials', name: 'Follow', note: 'Name, every handle, and a follow line. Use when the goal is growing the channel.' },
  { key: 'app', name: 'Shiurim Library App', note: 'Phone mockup of the app with a download call to action. Use for reels that lead into deeper learning.' },
  { key: 'combo', name: 'Follow + App', note: 'Both together: the handles row and an app badge. A safe default.' },
  { key: 'minimal', name: 'Minimal Signature', note: 'Just the name in Marcellus, a gold rule and one handle. Best after emotional or quiet clips.' },
];

const styleName = Object.fromEntries(styles.map((s) => [s.key, s.name]));
const endName = Object.fromEntries(ends.map((e) => [e.key, e.name]));
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const curatedCount = clips.filter((c: any) => c.curated).length;
const seriesList = [...new Map(clips.map((c: any) => [c.source, c.seriesLabel])).entries()];
const bar = (v: number) => `${Math.round((v / 3) * 100)}%`;
---

<Layout title="Reel Concepts" description="Short-form reel concepts for Rabbi Joseph Dweck: styles, closing cards and clip candidates.">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@500&family=Lato:wght@900&display=swap" rel="stylesheet" />

  <section class="page-hero">
    <h1>Reel Concepts</h1>
    <p>Looks, closing cards and {curatedCount} one-minute clip picks mined from 1,581 of Rabbi Dweck's shiurim. Read each quote, listen to it in the original recording, and give it a <strong>👍</strong> if it should become a reel. Approvals save instantly; approved quotes go into production with the look and closing card picked on the card. For review only; this page isn't in the site navigation.</p>
    <div class="gold-rule"></div>
    <nav class="jump">
      <a href="#looks">1 · Looks</a><a href="#ends">2 · Closing cards</a><a href="#clips">3 · Clip picks</a>
    </nav>
  </section>

  <!-- ───────────── LOOKS ───────────── -->
  <section class="section" id="looks">
    <div class="container">
      <h2 class="section-title">1 · Looks</h2>
      <div class="gold-divider"></div>
      <p class="lede">Five treatments, all set in <strong>Marcellus</strong> (the site's display face). Each preview loops through the hook card, Rabbi Dweck on camera with captions, a b-roll cutaway and the closing card. B-roll frames are AI concept stills (see the direction notes below).</p>
      <div class="look-grid">
        {styles.map((s, i) => (
          <figure class="look">
            <div class={`phone s-${s.key} demo`} data-demo={i}>
              <div class="ph-scene ph-rabbi" style="background-image:url(/reels/rabbi_a.jpg)"></div>
              <div class="ph-scene ph-broll" style={`background-image:url(/reels/broll_${broll[s.key][0]}.jpg)`}><span class="broll-chip">B-roll · {broll[s.key][1]}</span></div>
              {s.key === 'editorial' && <div class="ph-split-top" style={`background-image:url(/reels/broll_${broll[s.key][0]}.jpg)`}></div>}
              <div class="ph-bars"></div>
              <div class="ph-badge"><i></i><span>RABBI JOSEPH DWECK</span><i></i></div>
              <div class="ph-caps"><span>THE</span> <span>WORLD</span> <span class="k">DOESN'T</span> <span>NEED</span> <span>TO</span> <span class="k">MAKE</span> <span>SENSE</span></div>
              <div class="ph-hook">
                <div class="ph-water he">מַחְשָׁבָה</div>
                <div class="ph-kicker">Rabbi Dweck</div>
                <div class="ph-line"></div>
                <div class="ph-hookt"><span>The World Doesn't</span><span>Owe You Logic</span></div>
                <div class="ph-by">Rabbi Joseph Dweck</div>
              </div>
              <div class="ph-end end-combo"></div>
            </div>
            <figcaption>
              <h3>{s.name}</h3>
              <p>{s.note}</p>
              <div class="vote" data-concept={`style:${s.key}`}>
                <button data-v="yes">Love it</button><button data-v="maybe">Maybe</button><button data-v="no">No</button>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>

      <h3 class="sub-h">Elevated b-roll direction</h3>
      <p class="lede">The bar for cutaways: cinematic, slow, graded warm, never generic stock-office footage. Cut to b-roll on the key line of each thought, for 2–4 seconds, while Rabbi Dweck's voice carries on. The frames below are AI-generated concept stills to show the bar; the real edit would use licensed stock or a shoot.</p>
      <div class="mood-grid">
        {moods.map((m) => (
          <figure class="mood">
            <img src={`/reels/broll_${m.img}.jpg`} alt={m.title} loading="lazy" />
            <figcaption><b>{m.title}</b>{m.note}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────────── CLOSING CARDS ───────────── -->
  <section class="section" id="ends" style="background:var(--cream);">
    <div class="container">
      <h2 class="section-title">2 · Closing cards</h2>
      <div class="gold-divider"></div>
      <p class="lede">The last 4–6 seconds of every reel. Each card works in any of the five looks; the navy and parchment versions are shown here.</p>
      <div class="end-grid">
        {ends.map((e, i) => (
          <figure class="look">
            <div class={`phone ${i % 2 ? 's-parchment' : 's-navy'} endonly`}>
              <div class={`ph-end show end-${e.key}`}></div>
            </div>
            <figcaption>
              <h3>{e.name}</h3>
              <p>{e.note}</p>
              <div class="vote" data-concept={`end:${e.key}`}>
                <button data-v="yes">Love it</button><button data-v="maybe">Maybe</button><button data-v="no">No</button>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="fine">Handles from the site header: Instagram &amp; X <strong>@rabbidweck</strong>, YouTube channel, WhatsApp community, rabbijosephdweck.com. The app is shown as the Shiurim Library; confirm the store listing name before rendering.</p>
    </div>
  </section>

  <!-- ───────────── CLIPS ───────────── -->
  <section class="section" id="clips">
    <div class="container wide">
      <h2 class="section-title">3 · Clip picks</h2>
      <div class="gold-divider"></div>
      <p class="lede">Every shiur in the archive was cut into one-minute windows, and <strong>Jev</strong> (TypeSafe) scored each window on four things: opening hook, payoff, broad appeal, and whether it stands on its own. Each pick shows the quote, a player cued to that passage in the original recording, a suggested on-screen hook and b-roll shot list, and a suggested look and closing card (change either one). Quotes are automatic transcripts, so Hebrew terms may be garbled; the audio is the reference.</p>

      <div class="toolbar">
        <select class="seg-sel" id="seriesSel">
          <option value="all">All series</option>
          {seriesList.map(([k, l]) => <option value={k}>{l}</option>)}
        </select>
        <div class="seg" data-filter="status">
          <button class="on" data-val="all">Any status</button><button data-val="none">Unreviewed</button><button data-val="yes">Yes</button><button data-val="maybe">Maybe</button><button data-val="no">No</button>
        </div>
        <label class="chk"><input type="checkbox" id="showAll" /> Show all {clips.length} (incl. the next-best Jev picks)</label>
        <input type="search" id="q" placeholder="Search transcripts…" />
      </div>
      <div class="tally">
        <span id="tally"></span>
        <span id="sync" class="sync">Connecting…</span>
        <label class="who">Reviewer <input id="who" placeholder="your name" /></label>
        <button id="csv" class="ghost">Export picks (CSV)</button>
      </div>

      <div class="clip-list">
        {clips.map((c: any) => (
          <article class={`clip${c.curated ? '' : ' uncurated'}`} data-id={c.id} data-source={c.source}
            data-title={c.title} data-start={c.t0 ?? c.start} data-end={c.t1 ?? c.end_sec} data-shiur={c.shiur} data-audio={c.audio} data-hook={c.hook.join(' / ')}
            data-search={`${c.title} ${c.hook.join(' ')} ${c.text}`.toLowerCase()}>
            <div class={`phone mini s-${c.style}`} data-mini>
              <div class="ph-hook show">
                {c.he && <div class="ph-he he">{c.he}</div>}
                <div class="ph-kicker">{c.seriesLabel}</div>
                <div class="ph-line"></div>
                <div class="ph-hookt">{c.hook.map((l: string) => <span>{l}</span>)}</div>
                <div class="ph-by">Rabbi Joseph Dweck</div>
              </div>
            </div>
            <div class="clip-body">
              <div class="clip-meta">
                <span class="src">{c.seriesLabel}</span>
                <span>{c.t0 != null ? `${fmt(c.t0)}–${fmt(c.t1)}` : `≈ ${fmt(c.start)}`} in the shiur</span>
              </div>
              <h3>{c.title}</h3>
              <p class="shiur">From: {c.shiur}</p>
              <div class="jev" title="Jev scores, 0–3">
                <span>Hook <i style={`--w:${bar(c.jev.hook)}`}></i></span>
                <span>Payoff <i style={`--w:${bar(c.jev.payoff)}`}></i></span>
                <span>Appeal <i style={`--w:${bar(c.jev.appeal)}`}></i></span>
                <span>Standalone <i style={`--w:${Math.round(c.jev.standalone * 100)}%`}></i></span>
              </div>
              <blockquote class="quote">{c.text}</blockquote>
              {c.t0 != null
                ? <div class="listen"><span>Listen</span><audio controls preload="none" src={`${c.audio}#t=${c.t0},${c.t1}`}></audio></div>
                : c.curated && <p class="fine pending">Audio clip is being lined up with the recording…</p>}
              {c.why && <p class="why">{c.why}</p>}
              {c.trim && <p class="trim">✂ {c.trim}</p>}
              {c.broll.length > 0 && (
                <div class="broll">
                  {c.still && <img class="still" src={`/reels/broll_${c.still}.jpg`} alt="" loading="lazy" />}
                  <h4>B-roll shot list</h4>
                  <ol>{c.broll.map((b: string) => <li>{b}</li>)}</ol>
                </div>
              )}

              <div class="picks">
                <div class="vote big">
                  <button data-v="yes">👍 Approve</button><button data-v="maybe">Maybe</button><button data-v="no">👎 Pass</button>
                </div>
                <label>Look
                  <select data-k="style">{styles.map((s) => <option value={s.key} selected={s.key === c.style}>{s.name}</option>)}</select>
                </label>
                <label>Closing
                  <select data-k="end_card">{ends.map((e) => <option value={e.key} selected={e.key === c.end}>{e.name}</option>)}</select>
                </label>
              </div>
              <div class="reel"></div>
              <textarea data-k="notes" rows="1" placeholder="Notes: trim points, alternative hook, b-roll ideas…"></textarea>
            </div>
          </article>
        ))}
      </div>
      <p class="fine">Choices save to Supabase (<code>dweck_reel_picks</code>) the moment you click. Anyone with this link sees the same picks.</p>
    </div>
  </section>

  <template id="tpl-end-socials">
    <div class="e-water he">רב יוסף דוויק</div>
    <div class="e-kicker">Follow for more</div>
    <div class="e-name">Rabbi Joseph Dweck</div>
    <div class="e-rule"></div>
    <ul class="e-handles">
      <li><b>IG</b>@rabbidweck</li><li><b>YT</b>Rabbi Joseph Dweck</li><li><b>X</b>@rabbidweck</li><li><b>WA</b>Community</li>
    </ul>
    <div class="e-site">rabbijosephdweck.com</div>
  </template>
  <template id="tpl-end-app">
    <div class="e-kicker">Keep learning</div>
    <div class="e-app">
      <img src="/reels/app_library.webp" alt="" class="e-shot s1" />
      <img src="/reels/app_player.webp" alt="" class="e-shot s2" />
    </div>
    <div class="e-title">Every shiur, in your pocket</div>
    <div class="e-badge"><span class="e-a">A</span>Shiurim Library app</div>
    <div class="e-site">rabbijosephdweck.com</div>
  </template>
  <template id="tpl-end-combo">
    <div class="e-water he">רב יוסף דוויק</div>
    <div class="e-name">Rabbi Joseph Dweck</div>
    <div class="e-rule"></div>
    <div class="e-follow">@rabbidweck</div>
    <div class="e-icons"><span>IG</span><span>YT</span><span>X</span><span>WA</span></div>
    <div class="e-badge"><span class="e-a">A</span>Full shiurim on the app</div>
    <div class="e-site">rabbijosephdweck.com</div>
  </template>
  <template id="tpl-end-minimal">
    <div class="e-name big">Rabbi Joseph Dweck</div>
    <div class="e-rule"></div>
    <div class="e-follow">@rabbidweck</div>
  </template>
</Layout>

<script is:inline define:vars={{ styleName, endName }}>
  const SB_URL = 'https://qukziojymwlvmrzapgyo.supabase.co/rest/v1/dweck_reel_picks';
  const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF1a3ppb2p5bXdsdm1yemFwZ3lvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTQwNjMxNzAsImV4cCI6MjA2OTYzOTE3MH0.I7oR9fcypn-BKb9AS4d2UlXrgvMbpTQtWySqxgAWGzo';
  const H = { apikey: SB_KEY, Authorization: 'Bearer ' + SB_KEY, 'Content-Type': 'application/json' };

  // fill closing-card templates
  document.querySelectorAll('.ph-end').forEach((el) => {
    const k = [...el.classList].find((c) => c.startsWith('end-'))?.slice(4);
    const t = document.getElementById('tpl-end-' + k);
    if (t) el.appendChild(t.content.cloneNode(true));
  });

  // looping demo phones: hook → talk → b-roll → talk → end
  const demos = document.querySelectorAll('.phone.demo');
  const phases = [['p-hook', 2200], ['p-talk', 2600], ['p-broll', 2400], ['p-talk2', 1800], ['p-end', 2600]];
  demos.forEach((ph, i) => {
    const caps = ph.querySelectorAll('.ph-caps span');
    let p = 0;
    const step = () => {
      ph.classList.remove(...phases.map((x) => x[0]));
      ph.classList.add(phases[p][0]);
      if (phases[p][0].startsWith('p-talk') || phases[p][0] === 'p-broll') {
        caps.forEach((c, j) => { c.classList.remove('on'); setTimeout(() => { caps.forEach((x) => x.classList.remove('on')); c.classList.add('on'); }, j * 300); });
      }
      const d = phases[p][1];
      p = (p + 1) % phases.length;
      setTimeout(step, d);
    };
    setTimeout(step, i * 350);
  });

  // ───── picks state ─────
  const state = {}; // id -> row
  const who = document.getElementById('who');
  try { who.value = localStorage.getItem('reelWho') || ''; } catch (e) {}
  who.addEventListener('change', () => { try { localStorage.setItem('reelWho', who.value); } catch (e) {} });
  const sync = document.getElementById('sync');
  const setSync = (t, bad) => { sync.textContent = t; sync.classList.toggle('bad', !!bad); };

  async function save(id, patch) {
    const now = new Date().toISOString();
    state[id] = { ...(state[id] || { clip_id: id }), ...patch, clip_id: id, updated_at: now };
    setSync('Saving…');
    try {
      // send only what changed so we never clobber the render worker's reel_* fields
      const body = { ...patch, clip_id: id, updated_at: now };
      if (who.value) body.reviewer = who.value;
      const r = await fetch(SB_URL + '?on_conflict=clip_id', { method: 'POST', headers: { ...H, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify(body) });
      if (!r.ok) throw new Error(await r.text());
      setSync('Saved ✓');
    } catch (e) { console.error(e); setSync('Couldn’t save. Check your connection.', true); }
    paint(); tally();
  }

  function paint() {
    document.querySelectorAll('[data-id]').forEach((el) => {
      const row = state[el.dataset.id] || {};
      el.dataset.status = row.status || 'none';
      el.querySelectorAll('.vote button').forEach((b) => b.classList.toggle('on', b.dataset.v === row.status));
      el.querySelectorAll('[data-k]').forEach((f) => { if (row[f.dataset.k] != null && document.activeElement !== f) f.value = row[f.dataset.k]; });
      if (row.style) { const m = el.querySelector('[data-mini]'); m.className = m.className.replace(/s-\w+/, 's-' + row.style); }
      const reel = el.querySelector('.reel');
      if (reel) {
        const st = row.status === 'yes' ? row.reel_status : (row.reel_status === 'ready' ? 'ready' : null);
        reel.dataset.state = st || '';
        if (st === 'ready' && row.reel_url) {
          if (reel.dataset.url !== row.reel_url) { reel.dataset.url = row.reel_url; reel.innerHTML = `<video controls playsinline preload="metadata" src="${row.reel_url}"></video><a href="${row.reel_url}" download target="_blank" rel="noopener">Download MP4 ↓</a>`; }
        } else {
          reel.dataset.url = '';
          reel.innerHTML = st === 'queued' ? '🎬 Queued: the reel will be generated shortly' : st === 'rendering' ? '🎬 Generating the reel: b-roll, captions, render…' : st === 'error' ? `⚠ Render failed: ${row.reel_error || 'unknown error'}` : '';
        }
      }
    });
    document.querySelectorAll('[data-concept]').forEach((v) => {
      const row = state[v.dataset.concept] || {};
      v.querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.v === row.status));
    });
    filter();
  }

  function tally() {
    const rows = Object.values(state).filter((r) => !r.clip_id.includes(':'));
    const n = (s) => rows.filter((r) => r.status === s).length;
    document.getElementById('tally').innerHTML = `<b>${n('yes')}</b> 👍 approved · <b>${n('maybe')}</b> maybe · <b>${n('no')}</b> no`;
  }

  document.querySelectorAll('.clip').forEach((el) => {
    const id = el.dataset.id;
    const base = () => ({ title: el.dataset.title, source: el.dataset.source, start_sec: +el.dataset.start, end_sec: +el.dataset.end,
      shiur: el.dataset.shiur, audio_url: el.dataset.audio, hook: el.dataset.hook,
      style: el.querySelector('[data-k=style]').value, end_card: el.querySelector('[data-k=end_card]').value });
    el.querySelectorAll('.vote button').forEach((b) => b.addEventListener('click', () => {
      const row = state[id] || {}, next = row.status === b.dataset.v ? null : b.dataset.v;
      const patch = { ...base(), status: next };
      save(id, patch);
    }));
    el.querySelectorAll('select[data-k]').forEach((s) => s.addEventListener('change', () => save(id, { ...base() })));
    const ta = el.querySelector('textarea');
    ta.addEventListener('input', () => { ta.style.height = 'auto'; ta.style.height = ta.scrollHeight + 'px'; });
    ta.addEventListener('change', () => save(id, { ...base(), notes: ta.value }));
  });
  document.querySelectorAll('[data-concept]').forEach((v) => v.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
    const id = v.dataset.concept, cur = (state[id] || {}).status;
    const [kind, key] = id.split(':');
    save(id, { title: (kind === 'style' ? styleName : endName)[key], source: 'concept-' + kind, status: cur === b.dataset.v ? null : b.dataset.v });
  })));

  // filters
  const F = { source: 'all', status: 'all' };
  document.getElementById('seriesSel').addEventListener('change', (e) => { F.source = e.target.value; filter(); });
  document.querySelectorAll('.seg').forEach((seg) => seg.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
    seg.querySelectorAll('button').forEach((x) => x.classList.remove('on')); b.classList.add('on');
    F[seg.dataset.filter] = b.dataset.val; filter();
  })));
  const q = document.getElementById('q'), all = document.getElementById('showAll');
  q.addEventListener('input', filter); all.addEventListener('change', filter);
  function filter() {
    const term = q.value.trim().toLowerCase();
    document.querySelectorAll('.clip').forEach((el) => {
      const ok = (F.source === 'all' || el.dataset.source === F.source)
        && (F.status === 'all' || (el.dataset.status || 'none') === F.status)
        && (all.checked || !el.classList.contains('uncurated') || term)
        && (!term || el.dataset.search.includes(term));
      el.hidden = !ok;
    });
  }

  document.getElementById('csv').addEventListener('click', () => {
    const rows = Object.values(state).filter((r) => r.status && !r.clip_id.includes(':'));
    const cols = ['clip_id', 'status', 'title', 'shiur', 'source', 'start_sec', 'end_sec', 'audio_url', 'style', 'end_card', 'reel_url', 'notes'];
    const esc = (v) => '"' + String(v ?? '').replace(/"/g, '""') + '"';
    const csv = [cols.join(',')].concat(rows.map((r) => cols.map((c) => esc(r[c])).join(','))).join('\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = 'reel-picks.csv'; a.click();
  });

  const load = (first) => fetch(SB_URL + '?select=*', { headers: H }).then((r) => r.json()).then((rows) => {
    (Array.isArray(rows) ? rows : []).forEach((r) => { state[r.clip_id] = { ...(state[r.clip_id] || {}), ...r }; });
    if (first) setSync('Synced ✓');
    paint(); tally();
