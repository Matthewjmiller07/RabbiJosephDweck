// Normalise a string for fuzzy parasha matching
function normP(s: string): string {
  return s
    .toLowerCase()
    // strip years and common suffixes
    .replace(/\b(20\d\d)\b/g, '')
    .replace(/shabbat hagadol/gi, '')
    // spelling variants → canonical
    .replace(/\bvaera\b|\bva'era\b|\bva'era\b/g, 'vaera')
    .replace(/\bvayigash\b|\bvayiggash\b/g, 'vayiggash')
    .replace(/\bvayesheb\b|\bvayeshev\b/g, 'vayesheb')
    .replace(/\bmikets\b|\bmikkets\b/g, 'mikkets')
    .replace(/\bvayishlah\b|\bvayishlach\b/g, 'vayishlah')
    .replace(/\bvayetse\b|\bvayetzei\b/g, 'vayetse')
    .replace(/\btoledot\b|\btoldot\b/g, 'toledot')
    .replace(/\bhaye sarah\b|\bchayei sarah\b/g, 'haye sarah')
    .replace(/\bvayera\b|\bvayeira\b/g, 'vayera')
    .replace(/\blekh lekha\b|\blech lecha\b/g, 'lekh lekha')
    .replace(/\bbereshit\b|\bbereishit\b/g, 'bereshit')
    .replace(/\bnoah\b|\bnoach\b/g, 'noah')
    .replace(/\bvayhee\b|\bvayhi\b|\bvayehi\b/g, 'vayhee')
    .replace(/\bshemot\b|\bshemoth\b/g, 'shemot')
    .replace(/\bbeshalah\b|\bbeshallach\b/g, 'beshalah')
    .replace(/\byitro\b|\bjethro\b/g, 'yitro')
    .replace(/\bmishpatim\b/g, 'mishpatim')
    .replace(/\bteruma\b|\bterumah\b/g, 'terumah')
    .replace(/\btetsave\b|\btetsaveh\b|\btesave\b|\btezave\b/g, 'tetsaveh')
    .replace(/\bki tisa\b|\bki tissa\b/g, 'ki tissa')
    .replace(/\bvayakhel[-\s]pekude\b|\bvayakhel pekude\b/g, 'vayakhel-pekude')
    .replace(/\bvayikra\b/g, 'vayikra')
    .replace(/\btsav\b|\btzav\b/g, 'tsav')
    .replace(/\bshemini\b/g, 'shemini')
    .replace(/\btazria[-\s]metsora\b|\btazria metsora\b|\btazria-metzora\b/g, 'tazria-metsora')
    .replace(/\bahare[-\s]mot[-\s]kedoshim\b|\bahare[-\s]kedoshim\b|\bacharei kedoshim\b/g, 'ahare mot-kedoshim')
    .replace(/[^a-z\s-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

// Build map: canonical name → episodes sorted newest first
const spotifyMap = new Map<string, SpotifyEp[]>();

// Exclude nutshells/clips — only full shiurim
const NUTSHELL_RE = /nutshell|clip\s*#?\d*/i;

for (const ep of rssItems) {
  if (NUTSHELL_RE.test(ep.title)) continue;
  const norm = normP(ep.title);
  // Try to match against each canonical parasha name
  for (const book of books) {
    for (const p of book.portions) {
      const canon = normP(p.name);
      if (norm.includes(canon)) {
        const existing = spotifyMap.get(p.name) ?? [];
        existing.push(ep);
        spotifyMap.set(p.name, existing);
        break;
      }
    }
  }
}
// Sort each list newest→oldest
for (const [k, v] of spotifyMap) {
  spotifyMap.set(k, v.sort((a, b) => b.year - a.year));
}

const langColors: Record<string, string> = {
  "English": "var(--dark)",
  "Hebrew": "#7a5c1e",
  "Spanish": "#5a3e8c",
  "French": "#1a5276",
};

function ytThumb(url: string) {
  const long = url.match(/[?&]v=([^&]+)/);
  if (long) return `https://img.youtube.com/vi/${long[1]}/mqdefault.jpg`;
  const short = url.match(/youtu\.be\/([^?&]+)/);
  if (short) return `https://img.youtube.com/vi/${short[1]}/mqdefault.jpg`;
  return null;
}
