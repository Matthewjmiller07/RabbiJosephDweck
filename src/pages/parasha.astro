<style>
  .container { max-width: 1000px; margin: 0 auto; padding: 0 1.5rem; }

  /* Spotify */
  .spotify-wrap { max-width: 700px; border-radius: 12px; overflow: hidden; }

  /* YouTube */
  .yt-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
  .yt-block h3 {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--dark);
    margin-bottom: 0.75rem;
    letter-spacing: 0.04em;
  }
  .yt-embed-wrap {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
  }
  .yt-embed-wrap iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: none;
  }

  /* Browse by book */
  .book-section { margin-bottom: 3rem; }
  .book-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    border-bottom: 1px solid var(--cream-dark);
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .parasha-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  /* Parasha cards */
  .p-card {
    background: var(--white);
    border: 1px solid var(--cream-dark);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }
  .p-card--active { border-top: 3px solid var(--gold); }
  .p-card--plain { border-top: 3px solid var(--cream-dark); }
  .p-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }

  .p-thumb-link { display: block; }
  .p-thumb {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #000;
  }
  .p-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0.9; transition: opacity 0.2s; }
  .p-thumb:hover img { opacity: 0.7; }
  .p-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    color: white;
    opacity: 0;
    transition: opacity 0.2s;
    text-shadow: 0 2px 8px rgba(0,0,0,0.6);
  }
  .p-thumb:hover .p-play { opacity: 1; }

  .p-body { padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .p-name {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--dark);
    letter-spacing: 0.04em;
  }
  .p-shiur-title {
    font-size: 0.78rem;
    color: var(--text-light);
    line-height: 1.4;
    display: block;
  }
  .p-shiur-title:hover { color: var(--gold); }

  .p-links { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .p-summary-btn {
    font-family: var(--font-serif);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    background: transparent;
    border: 1px solid var(--gold);
    color: var(--gold);
    transition: background 0.2s, color 0.2s;
  }
  .p-summary-btn:hover { background: var(--gold); color: var(--white); }

  .p-clips { display: flex; flex-direction: column; gap: 0.25rem; }
  .p-clip-link {
    font-size: 0.72rem;
    color: var(--text-light);
    line-height: 1.3;
    transition: color 0.2s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .p-clip-link:hover { color: var(--gold); }

  .p-spotify { display: flex; flex-direction: column; align-items: flex-start; gap: 0.3rem; margin-top: 0.1rem; }
  .p-spotify-row { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .p-spotify-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-serif);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    background: transparent;
    border: 1px solid #1db954;
    color: #1db954;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .p-spotify-btn:hover { background: #1db954; color: #fff; }

  .p-older-list { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .p-older-link {
    font-size: 0.65rem;
    font-family: var(--font-serif);
    border: 1px solid #1db954;
    color: #1db954;
    padding: 0.1rem 0.4rem;
    opacity: 0.7;
    transition: opacity 0.2s;
    white-space: nowrap;
  }
  .p-older-link:hover { opacity: 1; }

  .lang-btns { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; padding-top: 0.25rem; }
  .lang-btn {
    font-family: var(--font-serif);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border: 1px solid;
    transition: background 0.2s, color 0.2s;
  }
  .lang-btn:hover {
    background: var(--gold) !important;
    color: var(--white) !important;
    border-color: var(--gold) !important;
  }

  @media (max-width: 680px) {
    .yt-grid { grid-template-columns: 1fr; }
    .reader-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
