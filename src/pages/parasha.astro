---
import Layout from '../layouts/Layout.astro';

type PDF = { lang: string; file: string };
type Clip = { title: string; url: string };
type Parasha = {
  name: string;
  shiurTitle?: string;
  shiurUrl?: string;
  summaryUrl?: string;
  clips?: Clip[];
  pdfs?: PDF[];
};
type Book = { book: string; portions: Parasha[] };

const books: Book[] = [
  {
    book: "Bereshit",
    portions: [
      { name: "Bereshit", shiurTitle: "Bereshit 2025 — What Does it All MEAN?", shiurUrl: "https://www.youtube.com/watch?v=cBEOtDjJYWk" },
      { name: "Noah", shiurTitle: "Noah 2025 — Who is Righteous?", shiurUrl: "https://www.youtube.com/watch?v=gh7fm1GUNRM" },
      { name: "Lekh Lekha", shiurTitle: "Lekh Lekha 2025 — Be On the Other Side", shiurUrl: "https://www.youtube.com/watch?v=L4TdruYCCYA" },
      { name: "Vayera", shiurTitle: "Vayera 2025 — Is God Paying Attention?", shiurUrl: "https://www.youtube.com/watch?v=2EM_N1Uv1t8" },
      { name: "Haye Sarah", shiurTitle: "Haye Sarah 2025 — What's Holding You Back?", shiurUrl: "https://www.youtube.com/watch?v=AOInDIgbrLw" },
