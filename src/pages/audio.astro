---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Audio" description="Audio lectures and recordings from Rabbi Joseph Dweck.">

  <section class="page-hero">
    <h1>Audio</h1>
    <p>Listen to Rabbi Dweck's lectures, shiurim, and classes</p>
    <div class="gold-rule"></div>
  </section>

  <section class="section" style="background:var(--cream);">
    <div class="container">
      <div class="audio-intro">
        <div class="audio-text">
          <h2 class="section-title">The Parasha with Rabbi Dweck</h2>
          <div class="gold-divider"></div>
          <p>
            Rabbi Dweck's weekly parasha discussions are available as a podcast on Spotify and all
            major podcast platforms. Subscribe to receive new episodes every week and never miss
            a parasha.
          </p>
          <p>
            In addition, hundreds of full-length lectures, shiurim, and study sessions are available
            through the links below.
          </p>
          <div style="margin-top:2rem; display:flex; gap:1rem; flex-wrap:wrap;">
            <a href="https://open.spotify.com/show/4K5FOrrlOXRepm29ENnj1S" target="_blank" rel="noopener" class="btn btn-solid">Listen on Spotify →</a>
            <a href="/parasha" class="btn">Full Archive</a>
          </div>
        </div>
        <div class="audio-img">
          <img src="/images/4959e2_4b9b31d3c03d4e9c84f60c45f7c0b188.png" alt="Audio recordings" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Available On</h2>
      <div class="gold-divider"></div>
      <div class="platform-row">

        <a href="https://open.spotify.com/show/4K5FOrrlOXRepm29ENnj1S" target="_blank" rel="noopener" class="audio-platform">
          <div class="ap-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" width="40" height="40" style="color:#1DB954"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
          </div>
          <h3>Spotify</h3>
          <p>The Parasha with Rabbi Dweck — weekly podcast</p>
        </a>

        <a href="https://youtube.com/channel/UCqIwxvf2D0JEgg0LOXZcFsA" target="_blank" rel="noopener" class="audio-platform">
          <div class="ap-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" width="40" height="40" style="color:#FF0000"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </div>
          <h3>YouTube</h3>
          <p>Full-length video lectures and shiurim</p>
        </a>

        <a href="https://chat.whatsapp.com/HONcznKDXy6KqXHI2Hptoj" target="_blank" rel="noopener" class="audio-platform">
          <div class="ap-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" width="40" height="40" style="color:#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </div>
          <h3>WhatsApp</h3>
          <p>Join the community for updates &amp; audio clips</p>
        </a>

      </div>
    </div>
  </section>

  <section class="section" style="background:var(--cream);">
    <div class="container">
      <h2 class="section-title">Lecture Series</h2>
      <div class="gold-divider"></div>
      <div class="series-grid">

        <a href="https://drive.google.com/drive/folders/1tqCMXteXoiwCfob31MM067eLsX49dHOn?usp=sharing" target="_blank" rel="noopener" class="series-card">
          <div class="series-label">Series</div>
          <h3>Perspectives Series</h3>
          <p>Contemporary issues explored through a Jewish lens</p>
          <span class="series-cta">Browse →</span>
        </a>

        <a href="https://drive.google.com/drive/folders/1EhWk_fxoLuriqAauKhijq1oJswAD9K8H?usp=sharing" target="_blank" rel="noopener" class="series-card">
          <div class="series-label">Series</div>
          <h3>Judaism and&hellip;</h3>
          <p>Lectures connecting Judaism with the broader human experience</p>
          <span class="series-cta">Browse →</span>
        </a>

        <a href="https://drive.google.com/drive/folders/1DIwrwbGKExl1JWigxsa62ziUtxno_rTW?usp=sharing" target="_blank" rel="noopener" class="series-card">
          <div class="series-label">Series</div>
          <h3>Let's Talk About God</h3>
          <p>An accessible series on theology and the divine</p>
          <span class="series-cta">Browse →</span>
        </a>

        <a href="https://drive.google.com/drive/folders/1kUVDzlGDv4JYxFovqFlS8u_Ho5fJQzcc?usp=sharing" target="_blank" rel="noopener" class="series-card">
          <div class="series-label">Series</div>
          <h3>Hilkhot Deot</h3>
          <p>Rambam on Personality &amp; Social Interactions</p>
          <span class="series-cta">Browse →</span>
        </a>

        <a href="https://drive.google.com/drive/folders/1ObW4JiIdS7yUK0cq0DMWCBH5gHdwOah0" target="_blank" rel="noopener" class="series-card">
          <div class="series-label">Addresses</div>
          <h3>Notable Speeches &amp; Addresses</h3>
          <p>Selected public addresses and keynote lectures</p>
          <span class="series-cta">Browse →</span>
        </a>

      </div>
    </div>
  </section>

</Layout>

<style>
  .audio-intro {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3.5rem;
    align-items: center;
  }
  .audio-text p { color: var(--text); line-height: 1.8; margin-bottom: 1rem; }
  .audio-img img {
    width: 100%;
    border-top: 4px solid var(--gold);
    box-shadow: 8px 8px 0 var(--cream-dark);
  }

  .platform-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .audio-platform {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.5rem;
    border: 1px solid var(--cream-dark);
    border-top: 3px solid var(--gold);
    background: var(--white);
    transition: box-shadow 0.25s, transform 0.25s;
  }
  .audio-platform:hover { box-shadow: 0 8px 30px rgba(0,0,0,0.1); transform: translateY(-3px); }
  .ap-icon { margin-bottom: 1rem; }
  .audio-platform h3 { font-size: 1.05rem; margin-bottom: 0.3rem; color: var(--dark); }
  .audio-platform p { font-size: 0.85rem; color: var(--text-light); }

  /* Lecture Series */
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .series-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem;
    background: var(--white);
    border: 1px solid var(--cream-dark);
    border-top: 3px solid var(--gold);
    transition: box-shadow 0.25s, transform 0.25s;
    gap: 0.4rem;
  }
  .series-card:hover { box-shadow: 0 8px 30px rgba(0,0,0,0.1); transform: translateY(-3px); }
  .series-label {
    font-family: var(--font-serif);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .series-card h3 {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--dark);
    line-height: 1.3;
  }
  .series-card p {
    font-size: 0.85rem;
    color: var(--text-light);
    line-height: 1.6;
    flex: 1;
  }
  .series-cta {
    font-family: var(--font-serif);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--gold);
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .audio-intro { grid-template-columns: 1fr; }
  }
</style>
