---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Video" description="Video lectures and recordings from Rabbi Joseph Dweck.">

  <section class="page-hero">
    <h1>Video</h1>
    <p>Lectures, shiurim, and recordings from Rabbi Joseph Dweck</p>
    <div class="gold-rule"></div>
  </section>

  <section class="section" style="background:var(--cream);">
    <div class="container">
      <div class="video-intro">
        <h2 class="section-title">Watch Rabbi Dweck</h2>
        <div class="gold-divider"></div>
        <p>
          A growing library of lectures, classes, and recordings from Rabbi Joseph Dweck is available
          on YouTube. From the weekly parasha to deep philosophical discussions, from Perspectives
          episodes to full-length shiurim — there is something for every level of learner.
        </p>
        <div style="margin-top:1.75rem; display:flex; gap:1rem; flex-wrap:wrap;">
          <a href="https://youtube.com/channel/UCqIwxvf2D0JEgg0LOXZcFsA" target="_blank" rel="noopener" class="btn btn-solid">Visit YouTube Channel →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Featured Playlists</h2>
      <div class="gold-divider"></div>
      <div class="playlist-grid">

        <a href="https://www.youtube.com/watch?v=NW_QEsmx3j0&list=PL2-vi4QcKgTSy_iM9Pm3mQZtAnXV6ePNn" target="_blank" rel="noopener" class="playlist-card">
          <img src="/images/The Parasha.png" alt="The Parasha" />
          <div class="playlist-info">
            <h3>The Parasha</h3>
            <p>Weekly Torah commentary — the complete annual cycle</p>
          </div>
        </a>

        <a href="https://www.youtube.com/watch?v=-bQ4gSF86w0&list=PL2-vi4QcKgTQxdpTqu-0Dju8Vado7Np6S" target="_blank" rel="noopener" class="playlist-card">
          <img src="/images/Perspectives.png" alt="Perspectives Season 1" />
          <div class="playlist-info">
            <h3>Perspectives — Season 1</h3>
            <p>God, Prayer, Suffering — foundational Jewish ideas</p>
          </div>
        </a>

        <a href="https://www.youtube.com/watch?v=BynNl13kxCE&list=PL2-vi4QcKgTSGcfSo3p2Tsr33Vp9fYLDJ" target="_blank" rel="noopener" class="playlist-card">
          <img src="/images/Perspectives.png" alt="Perspectives Season 2" />
          <div class="playlist-info">
            <h3>Perspectives — Season 2</h3>
            <p>Shabbat, Pesah, Shabuot — 1–3 minute episodes</p>
          </div>
        </a>

        <a href="https://www.youtube.com/watch?v=RbevpHdK0CY&list=PL2-vi4QcKgTQ8potwolwzD-Q7B9uXIi6E" target="_blank" rel="noopener" class="playlist-card">
          <img src="/images/The Thought for the Day.png" alt="Thought for the Day" />
          <div class="playlist-info">
            <h3>Thought for the Day</h3>
            <p>Daily reflections and insights from Rabbi Dweck</p>
          </div>
        </a>

      </div>
    </div>
  </section>

</Layout>

<style>
  .video-intro p { color: var(--text); line-height: 1.8; max-width: 700px; }

  .playlist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .playlist-card {
    display: block;
    border: 1px solid var(--cream-dark);
    border-top: 3px solid var(--gold);
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s;
    background: var(--white);
  }
  .playlist-card:hover { box-shadow: 0 8px 30px rgba(0,0,0,0.1); transform: translateY(-3px); }
  .playlist-card img { width: 100%; height: 180px; object-fit: cover; display: block; }
  .playlist-info { padding: 1.25rem; }
  .playlist-info h3 { font-size: 1rem; margin-bottom: 0.3rem; color: var(--dark); }
  .playlist-info p { font-size: 0.85rem; color: var(--text-light); }
</style>
