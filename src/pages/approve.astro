---
import Layout from '../layouts/Layout.astro';
import episodes from '../data/approvals.json';

// Each episode is written here by the Haftara studio pipeline (RJD Work/Haftara/studio/produce.py): the finished full
// episode plus its reels. Decisions and notes save to Supabase dweck_reel_picks under clip ids "haftara:<slug>:<item>".
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
---

<Layout title="For Approval" description="Finished Haftara Series episodes and reels awaiting approval.">
  <section class="section">
    <div class="container wide">
      <h2 class="section-title">For approval</h2>
      <div class="gold-divider"></div>
      <p class="lede">Finished videos for <strong>The Parasha with Rabbi Dweck · Haftara Series</strong>. Watch each one, then mark it <strong>Approve</strong>, <strong>Needs changes</strong> (say what in the note), or <strong>Reject</strong>. Choices save the moment you click, and everyone with this link sees the same marks.</p>
      <div class="who-row">
        <label>Your name <input id="who" placeholder="e.g. Rabbi Dweck" autocomplete="name" /></label>
        <span id="sync" class="sync">Loading saved choices…</span>
      </div>

      {episodes.length === 0 && <p class="fine">Nothing waiting for approval yet.</p>}

      {episodes.map((ep) => {
        const full = ep.items.filter((i) => i.kind === 'full');
        const reels = ep.items.filter((i) => i.kind === 'reel');
        return (
          <article class="episode" id={ep.slug}>
            <header>
              <p class="kicker">{ep.parasha}</p>
              <h3>{ep.title}</h3>
              <p class="count">{full.length ? 'Full episode' : ''}{full.length && reels.length ? ' + ' : ''}{reels.length ? `${reels.length} reels` : ''}</p>
            </header>

            {full.map((it) => (
              <div class="item full" data-id={it.id} data-title={it.title} data-url={it.url} data-shiur={`${ep.parasha}: ${ep.title}`}>
                {it.hls
                  ? <video controls playsinline preload="none" poster={it.poster} data-hls={it.url}></video>
                  : <video controls playsinline preload="metadata" poster={it.poster} src={it.url}></video>}
                <div class="meta">
                  <h4>Full episode <span class="dur">{mmss(it.duration)}</span></h4>
                  <p class="fine">Opening title → logo → the class → closing card (YouTube · Spotify · the app), with “A Touching Story” under the opening and closing. This is a smaller review copy; the 1080p master is saved as <code>{it.master}</code>.</p>
                  <div class="vote"><button data-v="yes">Approve</button><button data-v="maybe">Needs changes</button><button data-v="no">Reject</button></div>
                  <textarea placeholder="Notes (what to change, where — e.g. “trim the end at 34:10”)"></textarea>
                  <p class="by"></p>
                </div>
              </div>
            ))}

            {reels.length > 0 && <h4 class="sub">Reels</h4>}
            <div class="reel-grid">
              {reels.map((it) => (
                <div class="item reel" data-id={it.id} data-title={it.title} data-url={it.url} data-shiur={`${ep.parasha}: ${ep.title}`} data-start={it.start} data-end={it.end} data-hook={it.hook.join(' / ')}>
                  <video controls playsinline preload="none" poster={it.poster} src={it.url}></video>
                  <div class="meta">
                    <h4>{it.hook.join(' ')}</h4>
                    <p class="when">{mmss(it.start)}–{mmss(it.end)} in the class · {it.duration}s</p>
                    {it.why && <p class="why">{it.why}</p>}
                    <details><summary>Transcript</summary><p>{it.text}</p></details>
                    <div class="vote"><button data-v="yes">Approve</button><button data-v="maybe">Needs changes</button><button data-v="no">Reject</button></div>
                    <textarea placeholder="Notes"></textarea>
                    <p class="by"></p>
                  </div>
                </div>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Layout>

<script is:inline>
  const SB_URL = 'https://qukziojymwlvmrzapgyo.supabase.co/rest/v1/dweck_reel_picks';
  const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF1a3ppb2p5bXdsdm1yemFwZ3lvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTQwNjMxNzAsImV4cCI6MjA2OTYzOTE3MH0.I7oR9fcypn-BKb9AS4d2UlXrgvMbpTQtWySqxgAWGzo';
  const H = { apikey: SB_KEY, Authorization: 'Bearer ' + SB_KEY, 'Content-Type': 'application/json' };
  const state = {};
  const who = document.getElementById('who');
  const sync = document.getElementById('sync');
  const setSync = (t, bad) => { sync.textContent = t; sync.classList.toggle('bad', !!bad); };
  try { who.value = localStorage.getItem('reelWho') || ''; } catch (e) {}
  who.addEventListener('change', () => { try { localStorage.setItem('reelWho', who.value); } catch (e) {} });

  const LABEL = { yes: 'Approved', maybe: 'Needs changes', no: 'Rejected' };
  function paint() {
    document.querySelectorAll('.item[data-id]').forEach((el) => {
      const row = state[el.dataset.id] || {};
      el.dataset.status = row.status || 'none';
      el.querySelectorAll('.vote button').forEach((b) => b.classList.toggle('on', b.dataset.v === row.status));
      const ta = el.querySelector('textarea');
      if (document.activeElement !== ta) ta.value = row.notes || '';
      const by = el.querySelector('.by');
      by.textContent = row.status ? `${LABEL[row.status]}${row.reviewer ? ' by ' + row.reviewer : ''} · ${new Date(row.updated_at).toLocaleString()}` : '';
    });
  }

  async function save(el, patch) {
    const id = el.dataset.id, now = new Date().toISOString();
    const body = {
      clip_id: id, updated_at: now, source: 'haftara-approval', title: el.dataset.title, shiur: el.dataset.shiur,
      reel_url: el.dataset.url, reel_status: 'ready', ...patch,
    };
    if (el.dataset.start) { body.start_sec = +el.dataset.start; body.end_sec = +el.dataset.end; body.hook = el.dataset.hook; }
    if (who.value) body.reviewer = who.value;
    state[id] = { ...(state[id] || {}), ...body };
    paint();
    setSync('Saving…');
    try {
      const r = await fetch(SB_URL + '?on_conflict=clip_id', { method: 'POST', headers: { ...H, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify(body) });
      if (!r.ok) throw new Error(await r.text());
      setSync('Saved ✓');
    } catch (e) { console.error(e); setSync('Couldn’t save. Check your connection.', true); }
  }

  document.querySelectorAll('.item[data-id]').forEach((el) => {
    el.querySelectorAll('.vote button').forEach((b) => b.addEventListener('click', () => {
      const cur = (state[el.dataset.id] || {}).status;
      save(el, { status: cur === b.dataset.v ? null : b.dataset.v });
    }));
    const ta = el.querySelector('textarea');
    ta.addEventListener('change', () => save(el, { notes: ta.value }));
  });

  // long episodes are streamed as HLS (Supabase caps single uploads at 50MB): hls.js where supported, native on iOS
  const hlsVideos = document.querySelectorAll('video[data-hls]');
  if (hlsVideos.length) {
    const attach = () => hlsVideos.forEach((v) => {
      if (window.Hls && Hls.isSupported()) { const h = new Hls(); h.loadSource(v.dataset.hls); h.attachMedia(v); }
      else v.src = v.dataset.hls;
    });
    const s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/hls.js@1.5.17/dist/hls.min.js';
    s.onload = attach; s.onerror = attach;
    document.head.appendChild(s);
  }

  fetch(SB_URL + '?clip_id=like.haftara:*&select=clip_id,status,notes,reviewer,updated_at', { headers: H })
    .then((r) => r.json())
    .then((rows) => { rows.forEach((r) => { state[r.clip_id] = r; }); paint(); setSync('Up to date'); })
    .catch(() => setSync('Couldn’t load saved choices.', true));
</script>

<style>
  .container.wide { max-width: 1240px; }
  .who-row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin: 1.2rem 0 2rem; }
  .who-row input { margin-left: 0.5rem; padding: 0.45rem 0.7rem; border: 1px solid var(--cream-dark); border-radius: 6px; font: inherit; }
  .sync { font-size: 0.85rem; color: var(--text-light); }
  .sync.bad { color: #8a3a32; }
  .episode { margin: 2.5rem 0 4rem; scroll-margin-top: 6rem; }
  .episode header { margin-bottom: 1.2rem; }
  .kicker { font: 700 0.75rem var(--font-sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); margin: 0; }
  .episode h3 { font-size: 2rem; margin: 0.2rem 0; }
  .count { color: var(--text-light); margin: 0; }
  .sub { margin: 2.5rem 0 1rem; font-size: 1.3rem; }
  .item { background: #fff; border: 1px solid var(--cream-dark); border-left: 4px solid var(--cream-dark); border-radius: 10px; padding: 1rem; }
  .item[data-status=yes] { border-left-color: #2f6b46; }
  .item[data-status=maybe] { border-left-color: var(--gold); }
  .item[data-status=no] { border-left-color: #8a3a32; opacity: 0.7; }
  .item video { width: 100%; background: #000; border-radius: 8px; display: block; }
  .full { display: grid; grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr); gap: 1.4rem; align-items: start; }
  .full video { aspect-ratio: 16 / 9; }
  .reel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.2rem; }
  .reel video { aspect-ratio: 9 / 16; }
  .meta h4 { margin: 0.8rem 0 0.3rem; font-size: 1.1rem; line-height: 1.3; }
  .full .meta h4 { margin-top: 0; }
  .dur, .when { color: var(--text-light); font-size: 0.85rem; font-weight: 400; }
  .when { margin: 0 0 0.4rem; }
  .why { font-size: 0.9rem; margin: 0 0 0.4rem; }
  details { font-size: 0.85rem; margin: 0.3rem 0 0.6rem; }
  details p { margin: 0.4rem 0 0; line-height: 1.5; }
  .vote { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.6rem 0; }
  .vote button { font: 700 0.8rem var(--font-sans); padding: 0.5rem 0.9rem; border: 1px solid var(--cream-dark); background: #fff; color: var(--text); border-radius: 99px; cursor: pointer; }
  .vote button[data-v=yes].on { background: #e7f1ea; border-color: #2f6b46; color: #2f6b46; }
  .vote button[data-v=maybe].on { background: #fbf3e2; border-color: var(--gold); color: #7a5a1c; }
  .vote button[data-v=no].on { background: #f6e7e5; border-color: #8a3a32; color: #8a3a32; }
  textarea { width: 100%; min-height: 4.2rem; box-sizing: border-box; padding: 0.5rem 0.6rem; border: 1px solid var(--cream-dark); border-radius: 6px; font: inherit; font-size: 0.9rem; resize: vertical; }
  .by { font-size: 0.78rem; color: var(--text-light); margin: 0.4rem 0 0; min-height: 1em; }
  @media (max-width: 760px) { .full { grid-template-columns: 1fr; } }
</style>
