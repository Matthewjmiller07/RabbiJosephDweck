---
import Layout from '../layouts/Layout.astro';
import episodes from '../data/approvals.json';

// Each episode is written here by the Haftara studio pipeline (RJD Work/Haftara/studio/produce.py): the finished full
// episode plus its reels. Decisions and notes save to Supabase dweck_reel_picks under clip ids "haftara:<slug>:<item>".
// Tabs: one per episode, ?ep=<parasha> (e.g. /approve?ep=lekh-lekha). The newest episode opens by default.
const epKey = (parasha: string) => parasha.replace(/^Haftarat\s+/i, '').replace(/\s*\d{4}\s*$/, '').toLowerCase()
  .normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
---

<Layout title="For Approval" description="Finished Haftara Series episodes and reels awaiting approval.">
  <section class="section">
    <div class="container wide">
      <h2 class="section-title">For approval</h2>
      <div class="gold-divider"></div>
      <p class="lede">Finished videos for <strong>The Parasha with Rabbi Dweck · Haftara Series</strong>. Watch each one, then mark it <strong>Approve</strong>, <strong>Needs changes</strong> (say what in the note), or <strong>Reject</strong>. Choices save the moment you click, and everyone with this link sees the same marks.</p>
      <div class="who-row">
        <label>Your name <input id="who" placeholder="e.g. Rabbi Dweck" autocomplete="name" /></label>
        <span id="sync" class="sync">Loading saved choices…</span>
      </div>

      {episodes.length === 0 && <p class="fine">Nothing waiting for approval yet.</p>}
      {episodes.length > 0 && (
        <nav class="ep-tabs" aria-label="Episodes">
          {episodes.map((ep) => (
            <a href={`?ep=${epKey(ep.parasha)}`} data-ep={epKey(ep.parasha)} data-slug={ep.slug}>
              <span class="t-par">{ep.parasha.replace(/^Haftarat\s+/i, '').replace(/\s*\d{4}\s*$/, '')}</span>
              <span class="t-title">{ep.title}</span>
            </a>
          ))}
        </nav>
      )}

      {episodes.map((ep) => {
        const full = ep.items.filter((i) => i.kind === 'full');
        const reels = ep.items.filter((i) => i.kind === 'reel');
        return (
          <article class="episode" id={ep.slug} data-ep={epKey(ep.parasha)}>
            <header>
              <p class="kicker">{ep.parasha}</p>
              <h3>{ep.title}</h3>
              <p class="count">{full.length ? 'Full episode' : ''}{full.length && reels.length ? ' + ' : ''}{reels.length ? `${reels.length} reels` : ''}</p>
            </header>

            {full.map((it) => (
              <div class="item full" data-id={it.id} data-title={it.title} data-url={it.url} data-shiur={`${ep.parasha}: ${ep.title}`}>
                {it.hls
                  ? <video controls playsinline preload="none" poster={it.poster} data-hls={it.url}></video>
                  : <video controls playsinline preload="metadata" poster={it.poster} src={it.url}></video>}
                <div class="meta">
                  <h4>Full episode <span class="dur">{mmss(it.duration)}</span></h4>
                  <p class="fine">Opening title → logo → the class → closing card (YouTube · Spotify · the app), with “A Touching Story” under the opening and closing. This is a smaller review copy; the 1080p master is saved as <code>{it.master}</code>.</p>
                  <div class="vote"><button data-v="yes">Approve</button><button data-v="maybe">Needs changes</button><button data-v="no">Reject</button></div>
                  <textarea placeholder="Notes (what to change, where — e.g. “trim the end at 34:10”)"></textarea>
                  <p class="by"></p>
                  <details class="mark"><summary>Posted it yourself? Tick where</summary><div class="pfs"><label><input type="checkbox" data-pf="youtube" /> YouTube</label><label><input type="checkbox" data-pf="spotify" /> Spotify</label></div></details>
                </div>
              </div>
            ))}

            {ep.items.filter((i) => i.kind === 'description').map((it) => (
              <>
                <h4 class="sub">YouTube description</h4>
                <div class="item full desc" data-id={it.id} data-title={it.title} data-shiur={`${ep.parasha}: ${ep.title}`}>
                  <div>
                    <p class="kicker">Title</p>
                    <p class="yt-title">{it.title}</p>
                    <pre class="yt-desc">{it.text}</pre>
                  </div>
                  <div class="meta">
                    <h4>Description + chapters</h4>
                    <p class="fine">The chapter times match the finished video (they include the opening cards). Put any change in the note, e.g. “rename 12:40 to …”.</p>
                    <p><button type="button" class="copy" data-copy={it.text}>Copy description</button></p>
                    <div class="vote"><button data-v="yes">Approve</button><button data-v="maybe">Needs changes</button><button data-v="no">Reject</button></div>
                    <textarea placeholder="Notes"></textarea>
                    <p class="by"></p>
                  </div>
                </div>
              </>
            ))}

            {ep.items.filter((i) => i.kind === 'reader').map((it) => (
              <>
                <h4 class="sub">Parasha Reader (English)</h4>
                <div class="item full reader" data-id={it.id} data-title={it.title} data-url={it.url} data-shiur={`${ep.parasha}: ${ep.title}`}>
                  <object data={it.url} type="application/pdf"><a href={it.url} target="_blank" rel="noopener">Open the PDF</a></object>
                  <div class="meta">
                    <h4>{it.title}</h4>
                    <p class="fine"><a href={it.url} target="_blank" rel="noopener">Open PDF ↗</a>{it.google_doc && <> · <a href={it.google_doc} target="_blank" rel="noopener">Edit in the Google Doc ↗</a></>}</p>
                    <p class="fine">Approve the English and the translations (Spanish, French, Hebrew) are made next.</p>
                    {it.note && <p class="fine">{it.note}</p>}
                    <div class="vote"><button data-v="yes">Approve</button><button data-v="maybe">Needs changes</button><button data-v="no">Reject</button></div>
                    <textarea placeholder="Notes (or make edits straight in the Google Doc)"></textarea>
                    <p class="by"></p>
                  </div>
                </div>
              </>
            ))}

            {ep.items.filter((i) => i.kind === 'thumb').map((it) => (
              <>
                <h4 class="sub">YouTube thumbnail</h4>
                <div class="item full thumb" data-id={it.id} data-title={it.title} data-url={it.url} data-shiur={`${ep.parasha}: ${ep.title}`}>
                  <a href={it.url} target="_blank" rel="noopener"><img src={it.url} alt={`Thumbnail: ${it.title}`} loading="lazy" /></a>
                  <div class="meta">
                    <h4>{it.title}</h4>
                    {it.note && <p class="fine">{it.note}</p>}
                    <p class="fine"><a href={it.url} download target="_blank" rel="noopener">Full size ({it.size}) ↓</a></p>
                    <div class="vote"><button data-v="yes">Approve</button><button data-v="maybe">Needs changes</button><button data-v="no">Reject</button></div>
                    <textarea placeholder="Notes (e.g. “bigger headline”, “different photo”)"></textarea>
                    <p class="by"></p>
                  </div>
                </div>
              </>
            ))}

            {reels.length > 0 && <h4 class="sub">Reels</h4>}
            <div class="reel-grid">
              {reels.map((it) => (
                <div class="item reel" data-id={it.id} data-title={it.title} data-url={it.url} data-shiur={`${ep.parasha}: ${ep.title}`} data-start={it.start} data-end={it.end} data-hook={it.hook.join(' / ')} data-pre={it.pre_url} data-nm={it.nomusic_url} data-nmpre={it.nomusic_pre_url}>
                  <video controls playsinline preload="none" poster={it.poster} src={it.url}></video>
                  {it.pre_url && <div class="ends" role="group" aria-label="End card"><button type="button" class="on" data-end="full">Watch the full class</button><button type="button" data-end="pre">Coming Wednesday</button></div>}
                  {it.nomusic_url && <div class="ends music" role="group" aria-label="Music"><button type="button" class="on" data-music="1">With music</button><button type="button" data-music="0">No music</button></div>}
                  <p class="fine dl">Download: <a href={`${it.url}&download=${it.id.split(':').pop()}.mp4`}>{it.pre_url ? 'full-class ending' : 'reel'} ↓</a>{it.pre_url && <> · <a href={`${it.pre_url}&download=${it.id.split(':').pop()}-pre.mp4`}>coming-Wednesday ending ↓</a></>}{it.nomusic_url && <> · no music: <a href={`${it.nomusic_url}&download=${it.id.split(':').pop()}-nomusic.mp4`}>{it.nomusic_pre_url ? 'full-class ending' : 'reel'} ↓</a>{it.nomusic_pre_url && <> · <a href={`${it.nomusic_pre_url}&download=${it.id.split(':').pop()}-nomusic-pre.mp4`}>coming-Wednesday ending ↓</a></>}</>}</p>
                  <div class="meta">
                    <h4>{it.hook.join(' ')}</h4>
                    {it.credit && <p class="credit">— {it.credit}</p>}
                    <p class="when">{mmss(it.start)}–{mmss(it.end)} in the class · {it.duration}s</p>
                    {it.why && <p class="why">{it.why}</p>}
                    <details><summary>Transcript</summary><p>{it.text}</p></details>
                    <div class="vote"><button data-v="yes">Approve</button><button data-v="maybe">Needs changes</button><button data-v="no">Reject</button></div>
                    <textarea placeholder="Notes"></textarea>
                    <p class="by"></p>
                    <details class="mark"><summary>Posted it yourself? Tick where</summary><div class="pfs"><label><input type="checkbox" data-pf="youtube" /> YouTube Shorts</label><label><input type="checkbox" data-pf="tiktok" /> TikTok</label><label><input type="checkbox" data-pf="meta" /> Facebook + Instagram</label></div></details>
                  </div>
                </div>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Layout>

<script is:inline>
  const SB_URL = 'https://qukziojymwlvmrzapgyo.supabase.co/rest/v1/dweck_reel_picks';
  const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF1a3ppb2p5bXdsdm1yemFwZ3lvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTQwNjMxNzAsImV4cCI6MjA2OTYzOTE3MH0.I7oR9fcypn-BKb9AS4d2UlXrgvMbpTQtWySqxgAWGzo';
  const H = { apikey: SB_KEY, Authorization: 'Bearer ' + SB_KEY, 'Content-Type': 'application/json' };
  const state = {};
  const who = document.getElementById('who');
  const sync = document.getElementById('sync');
  const setSync = (t, bad) => { sync.textContent = t; sync.classList.toggle('bad', !!bad); };
  try { who.value = localStorage.getItem('reelWho') || ''; } catch (e) {}
  who.addEventListener('change', () => { try { localStorage.setItem('reelWho', who.value); } catch (e) {} });

  const LABEL = { yes: 'Approved', maybe: 'Needs changes', no: 'Rejected' };
  function paint() {
    document.querySelectorAll('.item[data-id]').forEach((el) => {
      const row = state[el.dataset.id] || {};
      el.dataset.status = row.status || 'none';
      el.querySelectorAll('.vote button').forEach((b) => b.classList.toggle('on', b.dataset.v === row.status));
      const ta = el.querySelector('textarea');
      if (document.activeElement !== ta) ta.value = row.notes || '';
      const by = el.querySelector('.by');
      by.textContent = row.status ? `${LABEL[row.status]}${row.reviewer ? ' by ' + row.reviewer : ''} · ${new Date(row.updated_at).toLocaleString()}` : '';
      const p = row.posted || {}, NAMES = { youtube: 'YouTube', spotify: 'Spotify', tiktok: 'TikTok', meta: 'Facebook + Instagram' };
      el.querySelectorAll('.mark input[data-pf]').forEach((c) => { c.checked = ['posted', 'scheduled'].includes((p[c.dataset.pf] || {}).status); });
      const bits = Object.keys(NAMES).filter((k) => p[k]).map((k) => {
        if (p[k].manual) return `${NAMES[k]}: posted by hand${p[k].by ? ' (' + p[k].by + ')' : ''}`;
        const s = p[k].status === 'scheduled' && p.slot ? `scheduled ${new Date(p.slot).toLocaleString([], { weekday: 'short', hour: '2-digit', minute: '2-digit' })}` : p[k].status;
        return p[k].url ? `<a href="${p[k].url}" target="_blank" rel="noopener">${NAMES[k]}</a>: ${s}` : `${NAMES[k]}: ${s}`;
      });
      if (p.expired) bits.push('no slot left before Shabbat');
      if (bits.length) by.innerHTML = by.textContent.replace(/</g, '&lt;') + '<br>' + bits.join(' · ');
    });
    if (typeof tally === 'function') tally();
  }

  async function save(el, patch) {
    const id = el.dataset.id, now = new Date().toISOString();
    const body = {
      clip_id: id, updated_at: now, source: 'haftara-approval', title: el.dataset.title, shiur: el.dataset.shiur,
      reel_url: el.dataset.url, reel_status: 'ready', ...patch,
    };
    if (el.dataset.start) { body.start_sec = +el.dataset.start; body.end_sec = +el.dataset.end; body.hook = el.dataset.hook; }
    if (who.value) body.reviewer = who.value;
    state[id] = { ...(state[id] || {}), ...body };
    paint();
    setSync('Saving…');
    try {
      const r = await fetch(SB_URL + '?on_conflict=clip_id', { method: 'POST', headers: { ...H, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify(body) });
      if (!r.ok) throw new Error(await r.text());
      setSync('Saved ✓');
    } catch (e) { console.error(e); setSync('Couldn’t save. Check your connection.', true); }
  }

  document.querySelectorAll('.item[data-id]').forEach((el) => {
    el.querySelectorAll('.vote button').forEach((b) => b.addEventListener('click', () => {
      const cur = (state[el.dataset.id] || {}).status;
      save(el, { status: cur === b.dataset.v ? null : b.dataset.v });
    }));
    const ta = el.querySelector('textarea');
    ta.addEventListener('change', () => save(el, { notes: ta.value }));
    // ticking a platform tells the poster it's already there (it never posts to a platform marked posted)
    el.querySelectorAll('.mark input[data-pf]').forEach((c) => c.addEventListener('change', () => {
      const posted = { ...((state[el.dataset.id] || {}).posted || {}) };
      if (c.checked) posted[c.dataset.pf] = { status: 'posted', manual: true, at: new Date().toISOString(), ...(who.value ? { by: who.value } : {}) };
      else delete posted[c.dataset.pf];
      save(el, { posted });
    }));
  });

  document.querySelectorAll('button.copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = 'Copied ✓'; } catch (e) { b.textContent = 'Select and copy the text'; }
    setTimeout(() => { b.textContent = 'Copy description'; }, 2000);
  }));

  // long episodes are streamed as HLS (Supabase caps single uploads at 50MB): hls.js where supported, native on iOS
  const hlsVideos = document.querySelectorAll('video[data-hls]');
  if (hlsVideos.length) {
    const attach = () => hlsVideos.forEach((v) => {
      if (window.Hls && Hls.isSupported()) { const h = new Hls(); h.loadSource(v.dataset.hls); h.attachMedia(v); }
      else v.src = v.dataset.hls;
    });
    const s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/hls.js@1.5.17/dist/hls.min.js';
    s.onload = attach; s.onerror = attach;
    document.head.appendChild(s);
  }

  // episode tabs (?ep=noah); old #slug links still land on the right tab
  const tabs = [...document.querySelectorAll('.ep-tabs a')];
  function showEp(key, push) {
    const t = tabs.find((a) => a.dataset.ep === key || a.dataset.slug === key) || tabs[0];
    if (!t) return;
    tabs.forEach((a) => a.classList.toggle('on', a === t));
    document.querySelectorAll('article.episode').forEach((a) => { a.hidden = a.dataset.ep !== t.dataset.ep; });
    document.querySelectorAll('article.episode[hidden] video').forEach((v) => v.pause());
    if (push) history.pushState(null, '', '?ep=' + t.dataset.ep);
    document.title = t.querySelector('.t-par').textContent + ' · For Approval';
  }
  tabs.forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); showEp(a.dataset.ep, true); }));
  const readKey = () => new URLSearchParams(location.search).get('ep') || location.hash.slice(1);
  window.addEventListener('popstate', () => showEp(readKey()));
  showEp(readKey());

  // per-tab tally: how many items are still waiting for a decision
  function tally() {
    tabs.forEach((a) => {
      const items = [...document.querySelectorAll(`article.episode[data-ep="${a.dataset.ep}"] .item[data-id]`)];
      const open = items.filter((el) => !(state[el.dataset.id] || {}).status).length;
      let b = a.querySelector('.t-n'); if (!b) { b = document.createElement('span'); b.className = 't-n'; a.appendChild(b); }
      b.textContent = open ? `${open} to review` : 'all reviewed';
      a.classList.toggle('done', !open);
    });
  }
  tally();

  fetch(SB_URL + '?clip_id=like.haftara:*&select=clip_id,status,notes,reviewer,updated_at,posted', { headers: H })
    .then((r) => r.json())
    .then((rows) => { rows.forEach((r) => { state[r.clip_id] = r; }); paint(); setSync('Up to date'); })
    .catch(() => setSync('Couldn’t load saved choices.', true));
  // Reels: switch between the end card that points to the full class and the one for posting before Wednesday
  // and between the version with music and the speech-only one (both endings exist for each)
  document.querySelectorAll('.reel').forEach((card) => card.addEventListener('click', (e) => {
    const b = e.target.closest('.ends button'); if (!b || b.classList.contains('on')) return;
    const v = card.querySelector('video'), playing = !v.paused;
    b.parentElement.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
    const pre = card.querySelector('[data-end].on')?.dataset.end === 'pre', plain = card.querySelector('[data-music].on')?.dataset.music === '0';
    const d = card.dataset;
    v.src = plain ? (pre ? d.nmpre : d.nm) : (pre ? d.pre : card.dataset.url); if (playing) v.play();
  }));
</script>

<style>
  .container.wide { max-width: 1240px; }
  .who-row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin: 1.2rem 0 2rem; }
  .who-row input { margin-left: 0.5rem; padding: 0.45rem 0.7rem; border: 1px solid var(--cream-dark); border-radius: 6px; font: inherit; }
  .sync { font-size: 0.85rem; color: var(--text-light); }
  .sync.bad { color: #8a3a32; }
  .ep-tabs { display: flex; gap: 0.5rem; overflow-x: auto; border-bottom: 1px solid var(--cream-dark); margin: 0 0 1rem; padding-bottom: 0; scrollbar-width: thin; }
  .ep-tabs a { flex: 0 0 auto; display: flex; flex-direction: column; gap: 0.1rem; padding: 0.6rem 1rem 0.7rem; text-decoration: none; color: var(--text); border: 1px solid transparent; border-bottom: none; border-radius: 8px 8px 0 0; margin-bottom: -1px; }
  .ep-tabs a.on { background: #fff; border-color: var(--cream-dark); border-bottom: 1px solid #fff; }
  .ep-tabs .t-par { font: 700 0.72rem var(--font-sans); letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); }
  .ep-tabs .t-title { font-size: 0.98rem; }
  .ep-tabs .t-n { font-size: 0.75rem; color: var(--text-light); }
  .ep-tabs a.done .t-n { color: #2f6b46; }
  .credit { font: 700 0.75rem var(--font-sans); letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); margin: 0 0 0.4rem; }
  .episode { margin: 2.5rem 0 4rem; scroll-margin-top: 6rem; }
  .episode header { margin-bottom: 1.2rem; }
  .kicker { font: 700 0.75rem var(--font-sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); margin: 0; }
  .episode h3 { font-size: 2rem; margin: 0.2rem 0; }
  .count { color: var(--text-light); margin: 0; }
  .sub { margin: 2.5rem 0 1rem; font-size: 1.3rem; }
  .item { background: #fff; border: 1px solid var(--cream-dark); border-left: 4px solid var(--cream-dark); border-radius: 10px; padding: 1rem; }
  .item[data-status=yes] { border-left-color: #2f6b46; }
  .item[data-status=maybe] { border-left-color: var(--gold); }
  .item[data-status=no] { border-left-color: #8a3a32; opacity: 0.7; }
  .item video { width: 100%; background: #000; border-radius: 8px; display: block; }
  .full { display: grid; grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr); gap: 1.4rem; align-items: start; }
  .full video { aspect-ratio: 16 / 9; }
  .yt-title { font-weight: 700; margin: 0.2rem 0 0.8rem; }
  .yt-desc { white-space: pre-wrap; font: 0.9rem/1.55 var(--font-sans); background: var(--cream); border: 1px solid var(--cream-dark); border-radius: 8px; padding: 1rem; margin: 0; max-height: 28rem; overflow: auto; }
  .copy { font: 700 0.8rem var(--font-sans); padding: 0.5rem 0.9rem; border: 1px solid var(--cream-dark); background: #fff; border-radius: 99px; cursor: pointer; }
  .reader object { width: 100%; aspect-ratio: 210 / 297; border: 1px solid var(--cream-dark); border-radius: 8px; background: #fff; }
  .thumb img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; display: block; }
  .reel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.2rem; }
  .reel video { aspect-ratio: 9 / 16; }
  .ends { display: flex; gap: 0.3rem; margin: 0.6rem 0 0; }
  .ends button { flex: 1; font: 700 0.75rem var(--font-sans); padding: 0.45rem 0.5rem; border: 1px solid var(--cream-dark); background: #fff; color: var(--text-light); border-radius: 99px; cursor: pointer; }
  .ends button.on { background: var(--cream); border-color: var(--gold); color: var(--text); }
  .fine { font-size: 0.8rem; color: var(--text-light); }
  .dl { margin: 0.5rem 0 0; }
  .dl a { color: inherit; }
  .meta h4 { margin: 0.8rem 0 0.3rem; font-size: 1.1rem; line-height: 1.3; }
  .full .meta h4 { margin-top: 0; }
  .dur, .when { color: var(--text-light); font-size: 0.85rem; font-weight: 400; }
  .when { margin: 0 0 0.4rem; }
  .why { font-size: 0.9rem; margin: 0 0 0.4rem; }
  details { font-size: 0.85rem; margin: 0.3rem 0 0.6rem; }
  details p { margin: 0.4rem 0 0; line-height: 1.5; }
  .vote { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.6rem 0; }
  .vote button { font: 700 0.8rem var(--font-sans); padding: 0.5rem 0.9rem; border: 1px solid var(--cream-dark); background: #fff; color: var(--text); border-radius: 99px; cursor: pointer; }
  .vote button[data-v=yes].on { background: #e7f1ea; border-color: #2f6b46; color: #2f6b46; }
