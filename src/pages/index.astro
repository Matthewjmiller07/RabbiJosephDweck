---
import Layout from '../layouts/Layout.astro';
import ReaderFeature from '../components/ReaderFeature.astro';
import AppPromo from '../components/AppPromo.astro';
import Newsletter from '../components/Newsletter.astro';

const APP_URL = 'https://RabbiJosephDweck.com/app';
const topics = ['The Parasha', 'The Haftara', 'Navi', 'Megillot', 'Tehillim', 'The Moadim', 'The Misvot', 'The 13 Principles', 'Perspectives', 'Mental Health'];
---

<Layout title="Rabbi Dweck's Office" description="The official website of Rabbi Joseph Dweck, Senior Rabbi of the S&P Sephardi Community of the United Kingdom: weekly Parasha shiurim, the Parasha Reader, the Rabbi Dweck App and newsletter.">

  <!-- HERO -->
  <section class="hero on-ink">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">The Office of Rabbi Joseph Dweck</p>
        <h1>Torah for the whole of life.</h1>
        <p class="hero-lede">
          Weekly shiurim on the Parasha and Haftara, the Parasha Reader for your Shabbat table,
          and a library of more than a thousand classes from the Senior Rabbi of the
          S&amp;P Sephardi Community of the United Kingdom.
        </p>
        <div class="hero-ctas">
          <a href="/parasha" class="btn btn-gold">This week's Parasha</a>
          <a href={APP_URL} target="_blank" rel="noopener" class="btn btn-ghost-light">Get the Rabbi Dweck App</a>
        </div>
        <div class="hero-stats">
          <div><strong>1,500+</strong><span>shiurim in the library</span></div>
          <div><strong>Every week</strong><span>a new Parasha shiur</span></div>
          <div><strong>Free</strong><span>Parasha Reader by email</span></div>
        </div>
      </div>
      <figure class="hero-arch">
        <img src="/images/GK5StT7XMAA8fJB.jpg" alt="Rabbi Joseph Dweck teaching" width="455" height="683" />
        <figcaption>Senior Rabbi, S&amp;P Sephardi Community</figcaption>
      </figure>
    </div>
  </section>

  <!-- TOPICS RIBBON -->
  <div class="ribbon" aria-label="Subjects">
    <div class="ribbon-track">
      {[...topics, ...topics].map((t) => (<span>{t}</span><i aria-hidden="true">✦</i>))}
    </div>
  </div>

  <!-- WAYS TO LEARN -->
  <section class="ways">
    <div class="wrap">
      <h2 class="h-section">Four Ways to Learn With Rabbi Dweck</h2>
      <div class="ways-grid">
        <a class="way" href="/parasha">
          <div class="way-media"><img src="/images/The Parasha.png" alt="" loading="lazy" /></div>
          <div class="way-body">
            <h3>The Parasha</h3>
            <p>A new shiur on the weekly portion and its Haftara, on YouTube, Spotify and every podcast app.</p>
            <span class="way-link">Watch and listen →</span>
          </div>
        </a>
        <a class="way" href="/reader">
          <div class="way-media way-media--paper" aria-hidden="true">
            <div class="mini-paper"><b>Parasha Reader</b><i></i><i></i><i class="s"></i><i></i><i class="s"></i></div>
          </div>
          <div class="way-body">
            <h3>The Parasha Reader</h3>
            <p>Two printable pages each week: the verses, a close gloss and the idea at the heart of the shiur.</p>
            <span class="way-link">Read this week's →</span>
          </div>
        </a>
        <a class="way" href={APP_URL} target="_blank" rel="noopener">
          <div class="way-media way-media--ink" aria-hidden="true">
            <img src="/reels/app_library.webp" alt="" class="way-phone" loading="lazy" />
          </div>
          <div class="way-body">
            <h3>The App</h3>
            <p>The full library by Parasha, Navi, Megillot, Tehillim and the Moadim, in your pocket.</p>
            <span class="way-link">Download the app →</span>
          </div>
        </a>
        <a class="way" href="/writings">
          <div class="way-media"><img src="/images/Perspectives.png" alt="" loading="lazy" /></div>
          <div class="way-body">
            <h3>Writings</h3>
            <p>Essays, Perspectives and articles on Jewish thought, law and the life of the community.</p>
            <span class="way-link">Start reading →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <ReaderFeature />

  <!-- LEARN BY SUBJECT -->
  <section class="subjects">
    <div class="wrap">
      <h2 class="h-section">Learn by Subject</h2>
      <p class="h-sub">Pick up a thread and follow it.</p>
      <div class="subj-grid">
        <a href="/parasha" class="subj"><span class="subj-he" lang="he">פרשה</span><h3>The Parasha</h3><p>The weekly portion, read closely and for today</p></a>
        <a href="/parasha" class="subj"><span class="subj-he" lang="he">מצוות</span><h3>The Misvot</h3><p>The meaning and practice of the commandments</p></a>
        <a href="/content" class="subj"><span class="subj-he" lang="he">עיקרים</span><h3>The 13 Principles</h3><p>Maimonides' foundations of Jewish belief</p></a>
        <a href="/perspectives" class="subj"><span class="subj-he" lang="he">השקפה</span><h3>Perspectives</h3><p>Jewish thought on the questions of our time</p></a>
        <a href="/mentalhealth" class="subj"><span class="subj-he" lang="he">נפש</span><h3>Mental Health</h3><p>Torah, wellbeing and the life of the soul</p></a>
        <a href="/thoughts" class="subj"><span class="subj-he" lang="he">מחשבה</span><h3>Thought for the Day</h3><p>A short idea to carry with you</p></a>
      </div>
    </div>
  </section>

  <!-- OFFICE -->
  <section class="office">
    <div class="wrap office-card">
      <div>
        <p class="eyebrow">The Office</p>
        <h2>Strengthening Jewish identity, around the world</h2>
      </div>
      <div>
        <p>
          Rabbi Dweck's office is involved in projects that are designed to ensure that the Jewish
          community's identity is robust and healthy, and that its spiritual ethos and philosophy is
          clear. This is achieved through Educational and Ambassadorial initiatives around the world.
        </p>
        <div class="office-links">
          <a href="/educational" class="btn-link">Educational initiatives →</a>
          <a href="/ambassadorial" class="btn-link">Ambassadorial initiatives →</a>
        </div>
      </div>
    </div>
  </section>

  <AppPromo />

  <Newsletter />

  <!-- STAY IN TOUCH -->
  <section class="touch">
    <div class="wrap">
      <h2 class="h-section">Stay in Touch</h2>
      <div class="touch-grid">
        <a href="https://chat.whatsapp.com/HONcznKDXy6KqXHI2Hptoj" target="_blank" rel="noopener" class="touch-card"><strong>WhatsApp</strong><span>New shiurim and announcements</span></a>
        <a href="https://youtube.com/channel/UCqIwxvf2D0JEgg0LOXZcFsA" target="_blank" rel="noopener" class="touch-card"><strong>YouTube</strong><span>Subscribe for every new class</span></a>
        <a href="https://www.instagram.com/rabbidweck" target="_blank" rel="noopener" class="touch-card"><strong>Instagram</strong><span>Short clips and reels, @rabbidweck</span></a>
        <a href="https://open.spotify.com/show/4K5FOrrlOXRepm29ENnj1S" target="_blank" rel="noopener" class="touch-card"><strong>Podcast</strong><span>The Parasha on Spotify and every podcast app</span></a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .wrap { max-width: 1140px; margin: 0 auto; padding: 0 1.5rem; }
  .h-section { font-size: clamp(2rem, 3.6vw, 2.75rem); margin-bottom: 1.75rem; }
  .h-sub { margin: -1.25rem 0 1.75rem; color: var(--text-light); }

  /* HERO */
  .hero { background: var(--ink) var(--star-pattern); color: var(--on-ink); padding: 5.5rem 1.5rem 5rem; }
  .hero-inner { max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 4rem; align-items: center; }
  .hero h1 { color: var(--on-ink); font-size: clamp(2.6rem, 5.6vw, 4.3rem); line-height: 1.08; margin-bottom: 1.25rem; }
  .hero-lede { font-size: 1.2rem; color: var(--on-ink-soft); max-width: 36rem; line-height: 1.65; }
  .hero-ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 2rem 0 2.5rem; }
  .hero-stats { display: flex; gap: 2.5rem; flex-wrap: wrap; border-top: 1px solid rgba(248,245,237,0.18); padding-top: 1.75rem; }
  .hero-stats div { display: flex; flex-direction: column; }
  .hero-stats strong { font-family: var(--font-serif); font-weight: 400; font-size: 2rem; color: var(--gold-bright); line-height: 1.1; }
  .hero-stats span { font-size: 0.9rem; color: var(--on-ink-soft); }

  .hero-arch { position: relative; margin: 0; justify-self: center; width: 100%; max-width: 420px; }
  .hero-arch img {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 20%;
    border-radius: 999px 999px 18px 18px; border: 2px solid var(--gold-bright);
    box-shadow: 0 30px 60px rgba(0,0,0,0.35);
  }
  .hero-arch figcaption {
    position: absolute; left: 50%; bottom: -1.1rem; transform: translateX(-50%); white-space: nowrap;
    background: var(--ink-deep); color: var(--gold-bright); border: 1px solid var(--gold-bright);
    border-radius: 999px; padding: 0.45rem 1.2rem; font-size: 0.88rem;
  }

  /* RIBBON */
  .ribbon { background: var(--parchment-dark); border-bottom: 1px solid var(--rule); overflow: hidden; padding: 0.9rem 0; }
  .ribbon-track { display: flex; align-items: center; gap: 2.25rem; width: max-content; animation: ribbon 60s linear infinite; }
  .ribbon span { font-family: var(--font-serif); font-size: 1.12rem; color: var(--text); white-space: nowrap; }
  .ribbon i { color: var(--gold); font-style: normal; font-size: 0.85rem; }
  @keyframes ribbon { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ribbon-track { animation: none; } }

  /* WAYS */
  .ways { padding: 5.5rem 0 4.5rem; }
  .ways-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.1rem; }
  .way { background: var(--paper); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; transition: box-shadow 0.25s, transform 0.25s; }
  .way:hover { box-shadow: 0 14px 34px rgba(19,24,48,0.1); transform: translateY(-3px); }
  .way-media { height: 170px; overflow: hidden; background: var(--parchment-dark); }
  .way-media img { width: 100%; height: 100%; object-fit: cover; }
  .way-media--ink { background: var(--ink) var(--star-pattern); display: grid; place-items: center; }
  .way-media--ink .way-phone { width: 66px; height: auto; border-radius: 10px; border: 3px solid #111; box-shadow: 0 10px 24px rgba(0,0,0,0.4); }
  .way-media--paper { background: var(--gold-bright); display: grid; place-items: center; }
  .mini-paper { width: 96px; height: 128px; background: #fffdf8; box-shadow: 0 10px 22px rgba(19,24,48,0.25); transform: rotate(-4deg); padding: 10px 9px; display: grid; gap: 6px; align-content: start; }
  .mini-paper b { font-family: var(--font-serif); font-weight: 400; font-size: 0.62rem; color: var(--ink); border-bottom: 1px solid var(--gold); padding-bottom: 3px; }
  .mini-paper i { display: block; height: 4px; background: #d9cfbf; border-radius: 2px; }
  .mini-paper i.s { width: 60%; }
  .way-body { padding: 1.35rem 1.25rem 1.4rem; display: flex; flex-direction: column; flex: 1; }
  .way-body h3 { font-size: 1.4rem; margin-bottom: 0.5rem; }
  .way-body p { font-size: 0.95rem; color: var(--text-light); line-height: 1.6; flex: 1; }
  .way-link { margin-top: 1.1rem; font-weight: 700; font-size: 0.92rem; color: var(--gold-dark); }

  /* SUBJECTS */
  .subjects { padding: 5rem 0; }
  .subj-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .subj { position: relative; overflow: hidden; background: var(--paper); border: 1px solid var(--rule); border-radius: var(--radius); padding: 1.6rem 1.4rem; min-height: 132px; transition: border-color 0.2s; }
  .subj:hover { border-color: var(--gold); }
  .subj-he { position: absolute; right: -0.25rem; top: -0.6rem; font-size: 3.8rem; line-height: 1; color: var(--gold-bright); opacity: 0.2; font-family: 'Times New Roman', serif; pointer-events: none; }
  .subj h3 { position: relative; font-size: 1.5rem; color: var(--ink); margin-bottom: 0.35rem; }
  .subj p { position: relative; font-size: 0.92rem; color: var(--text-light); }

  /* OFFICE */
  .office { padding: 0 0 5.5rem; }
  .office-card { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 3rem; align-items: center; }
  .office-card > div:first-child h2 { font-size: clamp(1.8rem, 3vw, 2.3rem); }
  .office-card { background: var(--paper); border: 1px solid var(--rule); border-radius: var(--radius); padding: 2.5rem; max-width: 1092px; }
  .office-card p { font-size: 1.05rem; }
  .office-links { display: flex; gap: 1.75rem; flex-wrap: wrap; margin-top: 1.1rem; }

  /* TOUCH */
  .touch { padding: 4.5rem 0 5rem; }
  .touch-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .touch-card { background: var(--paper); border: 1px solid var(--rule); border-radius: var(--radius); padding: 1.2rem 1.25rem; display: flex; flex-direction: column; transition: border-color 0.2s; }
  .touch-card:hover { border-color: var(--gold); }
  .touch-card strong { font-size: 1.02rem; color: var(--ink); }
  .touch-card span { font-size: 0.9rem; color: var(--text-light); }

  @media (max-width: 1000px) {
    .ways-grid, .touch-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .hero { padding: 3.5rem 1rem 4rem; }
    .hero-inner { grid-template-columns: 1fr; gap: 3rem; }
    .hero-arch { max-width: 300px; }
    .hero-stats { gap: 1.5rem; }
    .subj-grid { grid-template-columns: 1fr 1fr; }
    .office-card { grid-template-columns: 1fr; gap: 1rem; padding: 1.75rem; }
    .wrap { padding: 0 1rem; }
    .ways { padding: 3.5rem 0 3rem; }
    .subjects { padding: 3rem 0; }
    .office { padding-bottom: 3.5rem; }
  }
  @media (max-width: 560px) {
    .ways-grid, .touch-grid, .subj-grid { grid-template-columns: 1fr; }
    .hero-ctas .btn { width: 100%; }
  }
</style>
