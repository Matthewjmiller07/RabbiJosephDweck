---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rabbi Dweck's Office" description="Welcome to the official website of Rabbi Joseph Dweck, Senior Rabbi of the S&P Sephardi Community of the United Kingdom.">

  <!-- LOGO + SOCIAL -->
  <section class="intro-section">
    <div class="intro-inner">
      <img
        src="/images/Copy of ORD - Logo (A4.png"
        alt="The Office of Rabbi Dweck"
        class="site-logo"
      />

      <p class="connect-label">Connect with Rabbi Dweck</p>

      <div class="social-row">
        <a href="https://chat.whatsapp.com/HONcznKDXy6KqXHI2Hptoj" target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="32" height="32"><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.978-1.41A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.95 7.95 0 0 1-4.073-1.117l-.292-.174-3.035.86.872-2.965-.19-.304A7.96 7.96 0 0 1 4 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8zm4.406-5.884c-.242-.121-1.433-.707-1.655-.787-.222-.08-.384-.121-.545.121-.161.242-.626.787-.768.949-.141.161-.283.181-.525.06-.242-.121-1.022-.377-1.946-1.2-.719-.641-1.204-1.433-1.345-1.675-.141-.242-.015-.373.106-.493.109-.108.242-.283.363-.424.121-.141.161-.242.242-.404.08-.161.04-.303-.02-.424-.06-.121-.545-1.314-.747-1.799-.197-.472-.397-.408-.545-.415l-.464-.008c-.161 0-.424.06-.646.303-.222.242-.848.829-.848 2.021 0 1.192.869 2.344.99 2.506.121.161 1.71 2.611 4.144 3.661.579.25 1.031.399 1.383.511.581.185 1.11.159 1.528.097.466-.069 1.433-.586 1.635-1.152.202-.566.202-1.051.141-1.152-.06-.1-.222-.161-.464-.283z"/></svg>
          <span>Whatsapp</span>
        </a>
        <a href="https://www.instagram.com/rabbidweck" target="_blank" rel="noopener" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="32" height="32"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.336 3.608 1.311.975.975 1.249 2.242 1.311 3.608.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.062 1.366-.336 2.633-1.311 3.608-.975.975-2.242 1.249-3.608 1.311-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.062-2.633-.336-3.608-1.311-.975-.975-1.249-2.242-1.311-3.608C2.175 15.584 2.163 15.204 2.163 12s.012-3.584.07-4.85c.062-1.366.336-2.633 1.311-3.608.975-.975 2.242-1.249 3.608-1.311C8.416 2.175 8.796 2.163 12 2.163zm0-2.163C8.741 0 8.332.014 7.052.072 5.197.157 3.355.673 2.014 2.014.673 3.355.157 5.197.072 7.052.014 8.332 0 8.741 0 12c0 3.259.014 3.668.072 4.948.085 1.855.601 3.697 1.942 5.038 1.341 1.341 3.183 1.857 5.038 1.942C8.332 23.986 8.741 24 12 24s3.668-.014 4.948-.072c1.855-.085 3.697-.601 5.038-1.942 1.341-1.341 1.857-3.183 1.942-5.038C23.986 15.668 24 15.259 24 12s-.014-3.668-.072-4.948c-.085-1.855-.601-3.697-1.942-5.038C20.645.673 18.803.157 16.948.072 15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
          <span>Instagram</span>
        </a>
        <a href="https://youtube.com/channel/UCqIwxvf2D0JEgg0LOXZcFsA" target="_blank" rel="noopener" aria-label="YouTube">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="32" height="32"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
          <span>Youtube</span>
        </a>
        <a href="http://www.x.com/rabbidweck" target="_blank" rel="noopener" aria-label="X">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="32" height="32"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.91-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span>X</span>
        </a>
      </div>
    </div>
  </section>

  <!-- BODY TEXT -->
  <section class="body-section">
    <div class="body-inner">
      <p class="body-text">
        Rabbi Dweck's office is involved in projects that are designed to ensure that the Jewish
        community's identity is robust and healthy, and that its spiritual ethos and philosophy is
        clear. This is achieved through Educational and Ambassadorial initiatives around the world.
      </p>
      <div class="initiative-btns">
        <a href="/content" class="init-btn">Educational</a>
        <a href="/ambassadorial" class="init-btn">Ambassadorial</a>
      </div>
    </div>
  </section>

  <!-- PHOTO STRIP -->
  <section class="photo-strip">
    <img src="/images/GK5StT7XMAA8fJB.jpg" alt="Rabbi Dweck" class="strip-photo strip-photo--tall" />
    <img src="/images/perspectives shot.png" alt="Rabbi Dweck teaching" class="strip-photo" />
    <img src="/images/image.png" alt="Community" class="strip-photo" />
  </section>

  <!-- CONTENT TILES -->
  <section class="tiles-section">
    <div class="tiles-inner">
      <a href="/parasha" class="tile">
        <img src="/images/parasha  (2.png" alt="The Misvot" />
        <span>The Misvot</span>
      </a>
      <a href="/parasha" class="tile">
        <img src="/images/parasha  (1.png" alt="The Parasha" />
        <span>The Parasha</span>
      </a>
      <a href="/content" class="tile">
        <img src="/images/parasha .png" alt="The 13 Principles" />
        <span>The 13 Principles</span>
      </a>
    </div>
  </section>

  <!-- SUBSCRIBE -->
  <section class="subscribe-section">
    <div class="subscribe-inner">
      <h2>Stay updated</h2>
      <div class="brevo-wrap">
        <div class="sib-form">
          <div id="sib-form-container" class="sib-form-container">
            <div id="error-message" class="sib-form-message-panel" style="font-size:16px;text-align:left;font-family:Helvetica,sans-serif;color:#661d1d;background-color:#ffeded;border-radius:3px;border-color:#ff4949;max-width:540px;">
              <div class="sib-form-message-panel__text sib-form-message-panel__text--center">
                <svg viewBox="0 0 512 512" class="sib-icon sib-notification__icon"><path d="M256 40c118.621 0 216 96.075 216 216 0 119.291-96.61 216-216 216-119.244 0-216-96.562-216-216 0-119.203 96.602-216 216-216m0-32C119.043 8 8 119.083 8 256c0 136.997 111.043 248 248 248s248-111.003 248-248C504 119.083 392.957 8 256 8zm-11.49 120h22.979c6.823 0 12.274 5.682 11.99 12.5l-7 168c-.268 6.428-5.556 11.5-11.99 11.5h-8.979c-6.433 0-11.722-5.073-11.99-11.5l-7-168c-.283-6.818 5.167-12.5 11.99-12.5zM256 340c-15.464 0-28 12.536-28 28s12.536 28 28 28 28-12.536 28-28-12.536-28-28-28z"/></svg>
                <span class="sib-form-message-panel__inner-text">Your subscription could not be saved. Please try again.</span>
              </div>
            </div>
            <div></div>
            <div id="success-message" class="sib-form-message-panel" style="font-size:16px;text-align:left;font-family:Helvetica,sans-serif;color:#085229;background-color:#e7faf0;border-radius:3px;border-color:#13ce66;max-width:540px;">
              <div class="sib-form-message-panel__text sib-form-message-panel__text--center">
                <svg viewBox="0 0 512 512" class="sib-icon sib-notification__icon"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 464c-118.664 0-216-96.055-216-216 0-118.663 96.055-216 216-216 118.664 0 216 96.055 216 216 0 118.663-96.055 216-216 216zm141.63-274.961L217.15 376.071c-4.705 4.667-12.303 4.637-16.97-.068l-85.878-86.572c-4.667-4.705-4.637-12.303.068-16.97l8.52-8.451c4.705-4.667 12.303-4.637 16.97.068l68.976 69.533 163.441-162.13c4.705-4.667 12.303-4.637 16.97.068l8.451 8.52c4.668 4.705 4.637 12.303-.068 16.97z"/></svg>
                <span class="sib-form-message-panel__inner-text">Your subscription has been successful.</span>
              </div>
            </div>
            <div></div>
            <div id="sib-container" class="sib-container--large sib-container--vertical" style="text-align:center;background-color:rgba(255,255,255,1);max-width:540px;border-radius:3px;border-width:1px;border-color:#C0CCD9;border-style:solid;direction:ltr">
              <form id="sib-form" method="POST" action="https://0eb41038.sibforms.com/serve/MUIFANmF9RJH_c1u5gLlpNUFzCUskSVD2JOnv5CUfZYTzoj438iNTHZwmz03Er94cksSmyY0nFU2G4VNcXKKAkCBiAvy3cRosgmNDC_1V3iilOaV1Mrzps2ayWXDK8OYydyXBgpMxFObRnU7IZmMVNxnioLgczP-e47PurTZdXefQkMNg9NyXGgEXh0V6FhaPNockXbAd--0sjE2ng==" data-type="subscription">
                <div style="padding:8px 0;">
                  <div class="sib-form-block" style="font-size:32px;text-align:left;font-weight:700;font-family:Helvetica,sans-serif;color:#3C4858;background-color:transparent;">
                    <p>Newsletter</p>
                  </div>
                </div>
                <div style="padding:8px 0;">
                  <div class="sib-form-block" style="font-size:16px;text-align:left;font-family:Helvetica,sans-serif;color:#3C4858;background-color:transparent;">
                    <div class="sib-text-form-block"><p>Subscribe to our newsletter and stay updated.</p></div>
                  </div>
                </div>
                <div style="padding:8px 0;">
                  <div class="sib-input sib-form-block">
                    <div class="form__entry entry_block">
                      <div class="form__label-row">
                        <label class="entry__label" style="font-weight:700;text-align:left;font-size:16px;font-family:Helvetica,sans-serif;color:#3c4858;" for="EMAIL" data-required="*">Enter your email address to subscribe</label>
                        <div class="entry__field">
                          <input class="input" type="text" id="EMAIL" name="EMAIL" autocomplete="off" placeholder="EMAIL" data-required="true" required />
                        </div>
                      </div>
                      <label class="entry__error entry__error--primary" style="font-size:16px;text-align:left;font-family:Helvetica,sans-serif;color:#661d1d;background-color:#ffeded;border-radius:3px;border-color:#ff4949;"></label>
                      <label class="entry__specification" style="font-size:12px;text-align:left;font-family:Helvetica,sans-serif;color:#8390A4;">Provide your email address to subscribe. For e.g abc@xyz.com</label>
                    </div>
                  </div>
                </div>
                <div style="padding:8px 0;">
                  <div class="sib-form-block" style="text-align:left;">
                    <button class="sib-form-block__button sib-form-block__button-with-loader" style="font-size:16px;text-align:left;font-weight:700;font-family:Helvetica,sans-serif;color:#FFFFFF;background-color:#3E4857;border-radius:3px;border-width:0px;" form="sib-form" type="submit">
                      <svg class="icon clickable__icon progress-indicator__icon sib-hide-loader-icon" viewBox="0 0 512 512"><path d="M460.116 373.846l-20.823-12.022c-5.541-3.199-7.54-10.159-4.663-15.874 30.137-59.886 28.343-131.652-5.386-189.946-33.641-58.394-94.896-95.833-161.827-99.676C261.028 55.961 256 50.751 256 44.352V20.309c0-6.904 5.808-12.337 12.703-11.982 83.556 4.306 160.163 50.864 202.11 123.677 42.063 72.696 44.079 162.316 6.031 236.832-3.14 6.148-10.75 8.461-16.728 5.01z"/></svg>
                      SUBSCRIBE
                    </button>
                  </div>
                </div>
                <input type="text" name="email_address_check" value="" class="input--hidden" />
                <input type="hidden" name="locale" value="en" />
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  window.REQUIRED_CODE_ERROR_MESSAGE = 'Please choose a country code';
  window.LOCALE = 'en';
  window.EMAIL_INVALID_MESSAGE = window.SMS_INVALID_MESSAGE = "The information provided is invalid. Please review the field format and try again.";
  window.REQUIRED_ERROR_MESSAGE = "This field cannot be left blank. ";
  window.GENERIC_INVALID_MESSAGE = "The information provided is invalid. Please review the field format and try again.";
  window.translation = { common: { selectedList: '{quantity} list selected', selectedLists: '{quantity} lists selected', selectedOption: '{quantity} selected', selectedOptions: '{quantity} selected' } };
  var AUTOHIDE = Boolean(0);
</script>
<script defer src="https://sibforms.com/forms/end-form/build/main.js"></script>

<style>
  /* INTRO */
  .intro-section {
    padding: 4rem 1.5rem 2.5rem;
    text-align: center;
    background: var(--white);
  }
  .intro-inner { max-width: 560px; margin: 0 auto; }
  .site-logo {
    width: 200px;
    height: 200px;
    object-fit: contain;
    margin: 0 auto 2rem;
    display: block;
  }
  .connect-label {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-light);
    margin-bottom: 1.25rem;
  }
  .social-row {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }
  .social-row a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-light);
    font-size: 0.75rem;
    font-family: var(--font-serif);
    letter-spacing: 0.06em;
    transition: color 0.2s;
  }
  .social-row a:hover { color: var(--gold); }
  .social-row svg {
    width: 32px;
    height: 32px;
  }

  /* BODY */
  .body-section {
    padding: 3rem 1.5rem;
    background: var(--white);
    border-top: 1px solid var(--cream-dark);
  }
  .body-inner { max-width: 680px; margin: 0 auto; text-align: center; }
  .body-text {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--text);
    margin-bottom: 2rem;
  }
  .initiative-btns {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .init-btn {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dark);
    border-bottom: 2px solid var(--gold);
    padding-bottom: 2px;
    transition: color 0.2s;
  }
  .init-btn:hover { color: var(--gold); }

  /* PHOTO STRIP */
  .photo-strip {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 0;
    height: 420px;
  }
  .strip-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* TILES */
  .tiles-section {
    padding: 3.5rem 1.5rem;
    background: var(--white);
  }
  .tiles-inner {
    max-width: 860px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    transition: opacity 0.2s;
  }
  .tile:hover { opacity: 0.8; }
  .tile img {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .tile span {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-light);
  }

  /* SUBSCRIBE */
  .subscribe-section {
    padding: 3.5rem 1.5rem 4rem;
    background: var(--cream);
    text-align: center;
  }
  .subscribe-inner { max-width: 480px; margin: 0 auto; }
  .subscribe-inner h2 {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dark);
    margin-bottom: 1.5rem;
  }
  .sub-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .sub-form input {
    width: 100%;
    padding: 0.65rem 1rem;
    border: 1px solid #ccc;
    border-radius: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text);
    background: var(--white);
    outline: none;
    transition: border-color 0.2s;
  }
  .sub-form input:focus { border-color: var(--gold); }
  .sub-form button {
    margin-top: 0.25rem;
    padding: 0.7rem 2rem;
    background: var(--dark);
    color: var(--white);
    font-family: var(--font-serif);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    align-self: center;
  }
  .sub-form button:hover { background: var(--gold); }
  .sub-thanks {
    display: none;
    font-family: var(--font-serif);
    color: var(--gold);
    margin-top: 1rem;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  @media (max-width: 768px) {
    .photo-strip { grid-template-columns: 1fr; height: auto; }
    .strip-photo { height: 260px; }
    .tiles-inner { grid-template-columns: 1fr; max-width: 280px; }
    .social-row { gap: 1.25rem; }
  }
</style>
