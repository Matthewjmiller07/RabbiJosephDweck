---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const APP_URL = 'https://RabbiJosephDweck.com/app';
---

{compact ? (
  <aside class="app-strip">
    <div class="app-strip-inner">
      <img src="/reels/app_library.webp" alt="" class="app-strip-shot" width="52" height="112" loading="lazy" />
      <div class="app-strip-copy">
        <strong>The Rabbi Dweck App</strong>
        <span>Every shiur on the Parasha, Navi, Megillot, Tehillim and the Moadim, in your pocket.</span>
      </div>
      <a href={APP_URL} target="_blank" rel="noopener" class="btn btn-gold">Get the app</a>
    </div>
  </aside>
) : (
  <section class="app-promo" id="app">
    <div class="app-inner">
      <div class="app-phones" aria-hidden="true">
        <div class="phone phone-back"><img src="/reels/app_player.webp" alt="" loading="lazy" /></div>
        <div class="phone phone-front"><img src="/reels/app_library.webp" alt="" loading="lazy" /></div>
      </div>
      <div class="app-copy">
        <p class="eyebrow">The Rabbi Dweck App</p>
        <h2>A library of shiurim, wherever you are</h2>
        <p class="app-lede">
          Over a thousand of Rabbi Dweck's classes, arranged the way you learn: by Parasha, Navi,
          Megillot, Tehillim and the festivals. Listen on the way to work, pick up where you left off,
          and follow each week's Parasha as it comes out.
        </p>
        <ul class="app-features">
          <li><span>01</span>Browse by book and parasha</li>
          <li><span>02</span>Resume where you stopped</li>
          <li><span>03</span>New shiurim every week</li>
        </ul>
        <div class="app-ctas">
          <a href={APP_URL} target="_blank" rel="noopener" class="btn btn-solid">Download the app</a>
          <a href="/parasha" class="btn-link">Or listen on the web →</a>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .app-promo { background: var(--parchment-dark); padding: 5.5rem 1.5rem; overflow: hidden; }
  .app-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 4rem; align-items: center; }
  .app-phones { position: relative; height: 460px; }
  .phone {
    position: absolute; width: 200px; aspect-ratio: 157 / 340;
    background: #111; border-radius: 30px; padding: 8px;
    box-shadow: 0 30px 60px rgba(30, 15, 15, 0.28), inset 0 0 0 2px #333;
  }
  .phone img { width: 100%; height: 100%; object-fit: cover; border-radius: 22px; }
  .phone-front { left: 50%; top: 10px; transform: translateX(-20%) rotate(4deg); z-index: 2; }
  .phone-back { left: 50%; top: 40px; transform: translateX(-95%) rotate(-6deg); opacity: 0.92; }
  .app-promo h2 { font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: 1rem; }
  .app-lede { font-size: 1.08rem; color: var(--text); max-width: 34rem; }
  .app-features { list-style: none; margin: 1.75rem 0 2rem; display: grid; gap: 0.75rem; }
  .app-features li { display: flex; gap: 1rem; align-items: baseline; font-size: 1rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.75rem; }
  .app-features span { font-family: var(--font-serif); color: var(--gold-dark); font-size: 1.1rem; }
  .app-ctas { display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap; }

  .app-strip { background: var(--ink-soft); color: var(--parchment); padding: 1rem 1.5rem; }
  .app-strip-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; gap: 1.25rem; }
  .app-strip-shot { width: 40px; height: auto; border-radius: 6px; border: 2px solid #333; }
  .app-strip-copy { flex: 1; display: flex; flex-direction: column; line-height: 1.4; }
  .app-strip-copy strong { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 600; }
  .app-strip-copy span { font-size: 0.88rem; opacity: 0.8; }

  @media (max-width: 860px) {
    .app-inner { grid-template-columns: 1fr; gap: 2rem; }
    .app-phones { height: 360px; order: 2; }
    .phone { width: 150px; }
    .app-promo { padding: 3.5rem 1rem; }
  }
  @media (max-width: 560px) {
    .app-strip-inner { flex-wrap: wrap; }
    .app-strip-shot { display: none; }
  }
</style>
