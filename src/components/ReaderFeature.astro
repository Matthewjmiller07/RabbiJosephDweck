---
import readers from '../data/readers.json';
const latest = readers[0];
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<section class="reader-feature" id="reader">
  <div class="rf-inner">
    <div class="rf-copy">
      <p class="eyebrow">The Parasha Reader · {latest.series}</p>
      <h2>Two pages to bring to the Shabbat table</h2>
      <p class="rf-lede">
        Each week, the Parasha Reader sets out the heart of Rabbi Dweck's shiur: the Hebrew verses
        with a close English gloss, the idea at its centre, a quotation to think with and a book
        to read further. Print it, share it, and discuss it over Shabbat.
      </p>

      <div class="rf-latest">
        <span class="rf-tag">This edition</span>
        <h3>{latest.parasha}: <em>{latest.title}</em></h3>
        <p class="rf-meta">Shabbat {fmt(latest.date)} · {latest.pages} pages · {latest.langs.join(', ')}</p>
        <div class="rf-ctas">
          <a href={latest.pdf} target="_blank" rel="noopener" class="btn btn-solid">Read the PDF</a>
          <a href="/reader" class="btn-link">All editions →</a>
        </div>
      </div>

      <p class="rf-sub">Get it in your inbox each week: <a href="#newsletter">subscribe to the letter</a>.</p>
    </div>

    <a href={latest.pdf} target="_blank" rel="noopener" class="rf-paper" aria-label={`Open the ${latest.parasha} Parasha Reader`}>
      <div class="paper paper-under" aria-hidden="true"></div>
      <div class="paper paper-top">
        <div class="paper-head">
          <span>The Parasha with Rabbi Dweck</span>
          <span>{latest.series}</span>
        </div>
        <div class="paper-title">{latest.parasha}</div>
        <div class="paper-sub">{latest.title}</div>
        <div class="paper-cols">
          <div class="col he" dir="rtl">
            <i></i><i></i><i class="s"></i><i></i><i></i><i class="s"></i>
          </div>
          <div class="col en">
            <i></i><i></i><i></i><i class="s"></i><i></i><i></i><i></i><i class="s"></i>
          </div>
        </div>
        <div class="paper-box">The Idea</div>
        <div class="paper-lines"><i></i><i></i><i class="s"></i></div>
        <span class="paper-open">Open the PDF ↗</span>
      </div>
    </a>
  </div>
</section>

<style>
  .reader-feature { padding: 6rem 1.5rem; background: var(--parchment); }
  .rf-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 4.5rem; align-items: center; }
  .reader-feature h2 { font-size: clamp(2rem, 4vw, 2.9rem); margin-bottom: 1rem; }
  .rf-lede { font-size: 1.08rem; max-width: 36rem; }
  .rf-latest { margin-top: 2rem; padding: 1.5rem 1.75rem; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper); }
  .rf-tag { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-dark); font-weight: 700; }
  .rf-latest h3 { font-size: 1.7rem; margin: 0.25rem 0 0.25rem; }
  .rf-latest h3 em { color: var(--gold-dark); font-style: normal; }
  .rf-meta { font-size: 0.88rem; color: var(--text-light); }
  .rf-ctas { display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap; margin-top: 1.25rem; }
  .rf-sub { margin-top: 1.5rem; font-size: 0.95rem; color: var(--text-light); }
  .rf-sub a { color: var(--gold-dark); border-bottom: 1px solid currentColor; }

  .rf-paper { position: relative; display: block; aspect-ratio: 210 / 297; max-width: 380px; width: 100%; justify-self: center; }
  .paper { position: absolute; inset: 0; background: #fffdf8; border: 1px solid #e6dccb; }
  .paper-under { transform: rotate(4deg) translate(14px, 8px); box-shadow: 0 10px 30px rgba(40,20,10,0.12); }
  .paper-top {
    transform: rotate(-2deg); padding: 9% 9%; display: flex; flex-direction: column; gap: 4%;
    box-shadow: 0 24px 50px rgba(40,20,10,0.18); transition: transform 0.35s ease;
  }
  .rf-paper:hover .paper-top { transform: rotate(0deg) translateY(-6px); }
  .paper-head { display: flex; justify-content: space-between; font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--burgundy); border-bottom: 1px solid var(--gold); padding-bottom: 0.4rem; }
  .paper-title { font-family: var(--font-serif); font-size: 2rem; color: var(--ink); line-height: 1; margin-top: 2%; }
  .paper-sub { font-family: var(--font-serif); color: var(--gold-dark); font-size: 1.05rem; }
  .paper-cols { display: grid; grid-template-columns: 1fr 1.3fr; gap: 8%; }
  .paper-cols .col, .paper-lines { display: grid; gap: 7px; }
  .paper i { display: block; height: 5px; background: #d9cfbf; border-radius: 2px; }
  .paper .he i { background: #c9b28a; }
  .paper i.s { width: 60%; }
  .paper .he i.s { justify-self: start; }
  .paper-box { border: 1px solid var(--gold); padding: 6% 6%; font-family: var(--font-serif); font-size: 0.85rem; color: var(--gold-dark); letter-spacing: 0.1em; text-transform: uppercase; background: #fbf5e8; }
  .paper-open { margin-top: auto; align-self: flex-end; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--burgundy); font-weight: 700; }

  @media (max-width: 860px) {
    .rf-inner { grid-template-columns: 1fr; gap: 3rem; }
    .reader-feature { padding: 4rem 1rem; }
    .rf-paper { max-width: 300px; }
  }
</style>
